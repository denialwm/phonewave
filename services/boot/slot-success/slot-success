#!/bin/sh
# Marks the slot this Linux booted from as booted successfully once the boot
# has proved itself, so the bootloader stops spending its retries on
# it. Until then each boot uses one retry, and when they run out the bootloader
# falls back to the other slot. On Qualcomm phones the slot attributes are
# read from the GPT and written only through qbootctl; on Google's Tensor
# phones they are in the devinfo partition, which mark changes one bit of.
set -eu

conf=${SLOT_SUCCESS_CONF:-/etc/slot-success.conf}
qbootctl=${SLOT_SUCCESS_QBOOTCTL:-/usr/lib/slot-success/qbootctl}
bootconfig=${SLOT_SUCCESS_BOOTCONFIG:-/proc/bootconfig}
cmdline=${SLOT_SUCCESS_CMDLINE:-/proc/cmdline}
uptime=${SLOT_SUCCESS_UPTIME:-/proc/uptime}
partlabels=${SLOT_SUCCESS_PARTLABELS:-/dev/disk/by-partlabel}
# How long mark waits for systemd to finish starting, after the settle time.
startup_limit=300

fail() {
    echo "$*" >&2
    exit 2
}

setting() {
    sed -n "s/^$1=//p" "$conf" | tail -n 1
}

# The configuration names no slot: slot-success runs only in Linux, so the slot
# it runs from is Linux's. A slot= line from older configurations is ignored.
read_conf() {
    [ -r "$conf" ] || fail "Cannot read $conf."
    units=$(setting units)
    settle=$(setting settle)
    settle=${settle:-60}
    case $settle in
    '' | *[!0-9]*) fail "$conf: settle must be seconds, not '$settle'." ;;
    esac
}

# The slot the bootloader started, as bootconfig or the command line name it.
# A kernel with a built-in command line and no bootconfig gets neither; then
# the running slot is the active one, as qbootctl also assumes.
running_slot() {
    suffix=$(sed -n 's/^androidboot\.slot_suffix = "_\([ab]\)"$/\1/p' "$bootconfig" 2>/dev/null || true)
    if [ -z "$suffix" ]; then
        suffix=$(tr ' ' '\n' <"$cmdline" | sed -n 's/^androidboot\.slot_suffix=_\([ab]\)$/\1/p')
    fi
    if [ -z "$suffix" ]; then
        for candidate in a b; do
            read_bits "$candidate"
            if has_bit 50; then suffix="$suffix$candidate"; fi
        done
        case $suffix in
        a | b) ;;
        *) suffix= ;;
        esac
    fi
    echo "$suffix"
}

# The GPT attribute bits of boot_<slot>, as sfdisk lists them: 48-49 priority,
# 50 active, 51-53 retries left, 54 successful, 55 unbootable. On a devinfo
# phone, the same bits from its devinfo record.
read_bits() {
    if devinfo; then
        read_devinfo "$1"
        return
    fi
    part=$(readlink -f "$partlabels/boot_$1") || fail "No boot_$1 partition."
    [ -e "$part" ] || fail "No boot_$1 partition."
    disk=$(lsblk -ndo PKNAME "$part")
    [ -n "$disk" ] || fail "Cannot find the disk holding $part."
    dump=$(sfdisk --dump "/dev/$disk") || fail "Cannot read the GPT of /dev/$disk."
    bits=" $(printf '%s\n' "$dump" |
        sed -n "s/.*name=\"boot_$1\".*attrs=\"\([^\"]*\)\".*/\1/p" |
        tr ' ' '\n' | sed -n 's/^GUID://p' | tr ',' ' ') "
}

has_bit() {
    case $bits in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
    esac
}

retries() {
    if devinfo; then
        echo "$tries"
        return
    fi
    n=0
    if has_bit 51; then n=$((n + 1)); fi
    if has_bit 52; then n=$((n + 2)); fi
    if has_bit 53; then n=$((n + 4)); fi
    echo "$n"
}

# Google's Tensor phones keep the slot attributes in the devinfo partition,
# as their boot control HAL (gs-common's bootctrl) reads and writes them: the
# magic "DEVI", version 3.x, and from byte 48 one 4-byte record per slot:
# the retries left, then flags 1 unbootable, 2 successful, 4 active.
# Qualcomm's devinfo partition has another magic, so it never matches.
devinfo_part=$partlabels/devinfo
devinfo() {
    [ -e "$devinfo_part" ] || return 1
    [ "$(head -c 4 "$devinfo_part")" = DEVI ] || return 1
    [ "$(devinfo_byte 4) $(devinfo_byte 5)" = "3 0" ]
}

devinfo_byte() {
    od -An -tu1 -j "$1" -N 1 "$devinfo_part" | tr -d ' '
}

# The slot record's offset and flags byte.
devinfo_slot() {
    if [ "$1" = a ]; then record=48; else record=52; fi
}

read_devinfo() {
    devinfo_slot "$1"
    tries=$(devinfo_byte "$record")
    flags=$(devinfo_byte $((record + 1)))
    [ -n "$tries" ] && [ -n "$flags" ] || fail "Cannot read $devinfo_part."
    bits=" "
    if [ $((flags & 4)) -ne 0 ]; then bits="${bits}50 "; fi
    if [ $((flags & 2)) -ne 0 ]; then bits="${bits}54 "; fi
    if [ $((flags & 1)) -ne 0 ]; then bits="${bits}55 "; fi
}

# Sets the successful flag and nothing else, as the HAL's markBootSuccessful
# does before its anti-rollback step, which slot-success never takes.
mark_devinfo() {
    devinfo_slot "$1"
    flags=$(devinfo_byte $((record + 1)))
    # shellcheck disable=SC2059 # the format is the octal escape
    printf "\\$(printf %03o $((flags | 2)))" |
        dd of="$devinfo_part" bs=1 seek=$((record + 1)) count=1 conv=notrunc,fsync status=none
}

# The running slot, or a failure when no source names exactly one.
linux_slot() {
    slot=$(running_slot)
    [ -n "$slot" ] || fail "Cannot tell which slot is running."
}

# Exit 0 only when another boot of the slot costs no retry.
status() {
    read_conf
    linux_slot
    read_bits "$slot"
    if has_bit 55; then
        echo "Slot $slot: unbootable."
        return 1
    fi
    if has_bit 54; then
        echo "Slot $slot: marked successful."
        return 0
    fi
    left=$(retries)
    if [ "$left" = 1 ]; then
        echo "Slot $slot: not marked successful, 1 boot try left."
    else
        echo "Slot $slot: not marked successful, $left boot tries left."
    fi
    return 1
}

# A boot counts once the system has been up for the settle time and systemd
# reports it running: every unit started and none failed.
wait_settled() {
    up=$(cut -d. -f1 "$uptime")
    if [ "$up" -lt "$settle" ]; then
        sleep $((settle - up))
    fi
    waited=0
    while :; do
        state=$(systemctl is-system-running 2>/dev/null || true)
        case $state in
        initializing | starting) ;;
        *) break ;;
        esac
        if [ "$waited" -ge "$startup_limit" ]; then
            echo "The system is still $state after $waited s; slot $slot stays unmarked." >&2
            return 1
        fi
        sleep 5
        waited=$((waited + 5))
    done
    if [ "$state" != running ]; then
        echo "The system is $state; slot $slot stays unmarked." >&2
        return 1
    fi
}

mark() {
    read_conf
    linux_slot
    read_bits "$slot"
    if has_bit 54; then
        echo "Slot $slot: already marked successful."
        return 0
    fi
    wait_settled
    for unit in $units; do
        if ! systemctl is-active --quiet "$unit"; then
            echo "$unit is not active; slot $slot stays unmarked." >&2
            return 1
        fi
    done
    if devinfo; then
        mark_devinfo "$slot"
    else
        if [ "$slot" = a ]; then number=0; else number=1; fi
        "$qbootctl" -m "$number"
    fi
    read_bits "$slot"
    if ! has_bit 54; then
        echo "The mark was written, but slot $slot still reads unmarked." >&2
        return 1
    fi
    echo "Slot $slot: marked successful."
}

case ${1-} in
status) status ;;
mark) mark ;;
running)
    linux_slot
    echo "$slot"
    ;;
*)
    echo "usage: slot-success status|mark|running" >&2
    exit 2
    ;;
esac
