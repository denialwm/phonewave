#!/bin/bash
# What a Qualcomm modem needs before it answers. dmail runs this and waits
# for the modem's services (DESIGN.md, Boot). With the modem up it changes
# nothing; a phone without a modem remoteproc has nothing to set up.
#
# Where the device tree gives the modem rmtfs memory, the modem keeps its
# file system (EFS) on rmtfs, served read-only from the phone's own
# partitions, and asks tqftpserv for its files (services/modem/linux-msm).
set -euo pipefail

mss=
for p in /sys/class/remoteproc/remoteproc*; do
	[[ -e $p/name && $(<"$p/name") == modem ]] && mss=$p
done
if [[ -z $mss ]]; then
	echo "modem-setup: no modem remoteproc" >&2
	exit 1
fi
# A crash stops the modem: no restart behind dmail's back, no memory dump.
# A crashed modem keeps its dump setting until it is stopped.
if [[ $(<"$mss/state") == crashed ]]; then
	echo stop > "$mss/state"
fi
echo disabled > "$mss/recovery"
echo disabled > "$mss/coredump"

if [[ -e /dev/qcom_rmtfs_mem1 ]]; then
	systemctl start rmtfs.service tqftpserv.service
	# The modem looks for rmtfs as it boots.
	rmtfs_up() {
		qrtr-lookup | awk '$1 == 14 { up = 1 } END { exit !up }'
	}
	for _ in {1..25}; do
		rmtfs_up && break
		sleep 0.2
	done
	if ! rmtfs_up; then
		echo "modem-setup: rmtfs is not serving" >&2
		exit 1
	fi
fi

state=$(<"$mss/state")
case $state in
running) ;;
offline) echo start > "$mss/state" ;;
*)
	echo "modem-setup: the modem is $state" >&2
	exit 1
	;;
esac
