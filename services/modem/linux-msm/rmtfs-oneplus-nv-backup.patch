+/*
+ * A property the bootloader passed, androidboot.slot_suffix say: from
+ * bootconfig (key = "value"), else the kernel command line (key=value).
+ * Returns 0 with the value in out.
+ */
+int boot_property(const char *key, char *out, size_t len)
+{
+	static const char *const sources[] = { "/proc/bootconfig", "/proc/cmdline" };
+	static char text[32768];
+	size_t keylen = strlen(key);
+	size_t n;
+	size_t m;
+	FILE *f;
+	char *p;
+	char *v;
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		f = fopen(sources[i], "r");
+		if (!f)
+			continue;
+		n = fread(text, 1, sizeof(text) - 1, f);
+		fclose(f);
+		text[n] = '\0';
+
+		for (p = text; (p = strstr(p, key)); p += keylen) {
+			/* The whole key, not the end of a longer one */
+			if (p != text && !isspace((unsigned char)p[-1]))
+				continue;
+			v = p + keylen;
+			while (*v == ' ')
+				v++;
+			if (*v != '=')
+				continue;
+			v++;
+			while (*v == ' ')
+				v++;
+			if (*v == '"')
+				v++;
+			m = strcspn(v, "\" \n");
+			if (m == 0 || m >= len)
+				return -1;
+			memcpy(out, v, m);
+			out[m] = '\0';
+			return 0;
+		}
+	}
+
+	return -1;
+}
