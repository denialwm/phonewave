+/*
+ * Newer OnePlus modems read 512 bytes past the end of the static NV backup:
+ * a board block that stock Android's rmt_storage builds from the phone's
+ * project information. Answered with zeros, the modem starts without its
+ * IMEIs. Where the boot image describes the board, in
+ * /usr/lib/modules/RELEASE/rmtfs/oplus-board (pcb=N and rf=N, the stock
+ * kernel's PCB version and nRF), the block follows the backup in the
+ * read-only copy the modem reads. The project number comes from the
+ * bootloader's androidboot.prjname; the four bytes after the region are
+ * the start of soc0's serial number.
+ */
+#define OPLUS_BOARD_SIZE 512
+
+static int oplus_board_block(uint8_t *block)
+{
+	char line[128];
+	char project[32];
+	char serial[4];
+	char *end;
+	struct utsname u;
+	unsigned long long prj;
+	long pcb = -1;
+	long rf = -1;
+	FILE *f;
+	int i;
+
+	if (uname(&u))
+		return -1;
+	snprintf(line, sizeof(line), "/usr/lib/modules/%s/rmtfs/oplus-board", u.release);
+	f = fopen(line, "r");
+	if (!f)
+		return -1;
+	while (fgets(line, sizeof(line), f)) {
+		if (strncmp(line, "pcb=", 4) == 0)
+			pcb = strtol(line + 4, NULL, 0);
+		else if (strncmp(line, "rf=", 3) == 0)
+			rf = strtol(line + 3, NULL, 0);
+	}
+	fclose(f);
+
+	if (pcb < 0 || pcb > 255 || rf < 0 || rf > 255) {
+		fprintf(stderr, "[storage] oplus-board needs pcb and rf, 0 to 255\n");
+		return -1;
+	}
+	if (boot_property("androidboot.prjname", project, sizeof(project))) {
+		fprintf(stderr, "[storage] oplus-board: the bootloader names no project\n");
+		return -1;
+	}
+	prj = strtoull(project, &end, 10);
+	if (*end) {
+		fprintf(stderr, "[storage] oplus-board: project '%s' is not a number\n", project);
+		return -1;
+	}
+	f = fopen("/sys/devices/soc0/serial_number", "r");
+	if (!f || fread(serial, 1, 4, f) != 4) {
+		fprintf(stderr, "[storage] oplus-board: no SoC serial number\n");
+		if (f)
+			fclose(f);
+		return -1;
+	}
+	fclose(f);
+
+	memset(block, 0, OPLUS_BOARD_SIZE);
+	/* Magic 0x87654321, little endian */
+	block[0] = 0x21;
+	block[1] = 0x43;
+	block[2] = 0x65;
+	block[3] = 0x87;
+	/* Region: stock's default */
+	memcpy(block + 391, "CE", 2);
+	memcpy(block + 423, serial, 4);
+	/* Stock's values where the phone has no SVN or RF cable property */
+	block[427] = 1;
+	block[428] = 255;
+	for (i = 0; i < 8; i++)
+		block[431 + i] = prj >> (8 * i);
+	block[439] = pcb;
+	block[440] = rf;
+
+	return 0;
+}
+
+static int storage_append_oplus_board(struct rmtfd *rmtfd, const struct partition *part)
+{
+	uint8_t block[OPLUS_BOARD_SIZE];
+	void *buf;
+
+	if (strcmp(part->actual, "oem_stanvbk") != 0 || oplus_board_block(block))
+		return 0;
+
+	buf = realloc(rmtfd->shadow_buf, rmtfd->shadow_len + OPLUS_BOARD_SIZE);
+	if (!buf)
+		return -1;
+	memcpy((char *)buf + rmtfd->shadow_len, block, OPLUS_BOARD_SIZE);
+	rmtfd->shadow_buf = buf;
+	rmtfd->shadow_len += OPLUS_BOARD_SIZE;
+	fprintf(stderr, "[storage] OnePlus board block after %s\n", part->path);
+
+	return 0;
+}
