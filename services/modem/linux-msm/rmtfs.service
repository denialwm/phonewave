[Unit]
Description=Modem file system from the phone's own partitions, read-only (rmtfs)

[Service]
Type=exec
# -P: modemst1, modemst2, fsg and fsc, Android's; -r: the modem's writes stay
# in memory, so the partitions never change.
ExecStart=/usr/bin/rmtfs -r -P
DevicePolicy=closed
DeviceAllow=/dev/qcom_rmtfs_mem1 rw
DeviceAllow=block-sd r
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
PrivateTmp=yes
