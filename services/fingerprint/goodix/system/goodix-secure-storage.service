# The Goodix trusted app's protected files and RPMB callbacks. A phone whose
# sensor needs it turns it on from its boot image's tail, with fprintd's
# drop-in. It keeps the trusted apps' files where stock does, under
# persist's data/, and commits their authenticated RPMB writes, which the
# Gatekeeper PIN needs. With persist mounted read-only (an override of
# run-goodix-persist.mount in /etc) it writes only under
# /var/lib/goodix-secure-storage, and no PIN can be set.
[Unit]
Description=Goodix protected-file storage and RPMB callbacks
Requires=run-goodix-persist.mount
After=run-goodix-persist.mount
Before=fprintd.service
Wants=phonewave-fingerprint-calibration.service
After=phonewave-fingerprint-calibration.service

[Service]
Type=notify
NotifyAccess=main
User=root
ExecStart=/usr/lib/phonewave-fingerprint/goodix-secure-storage
StateDirectory=goodix-secure-storage phonewave-fingerprint/templates
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=15
TimeoutStopSec=5
LimitCORE=0
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/run/goodix/persist/data
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
