[Unit]
Description=One Gatekeeper PIN request
Requires=goodix-secure-storage.service
After=goodix-secure-storage.service

[Service]
Type=exec
User=root
ExecStart=/usr/lib/phonewave-fingerprint/goodix-gatekeeper-worker
StandardInput=socket
StandardOutput=inherit
StandardError=journal
TimeoutStartSec=35
RuntimeMaxSec=35
LimitCORE=0
LimitMEMLOCK=1M
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
# The enrolled PIN's secure ID and handle; removing it allows a new PIN.
StateDirectory=goodix-gatekeeper
StateDirectoryMode=0700
