[Unit]
Description=The phone's persist partition, for Goodix secure storage
Before=goodix-secure-storage.service
# The first calibration copy mounts persist read-only in its own namespace,
# which fails while this mount holds it read-write.
After=phonewave-fingerprint-calibration.service
StopWhenUnneeded=yes

[Mount]
What=/dev/disk/by-partlabel/persist
Where=/run/goodix/persist
Type=ext4
# Writable: secure storage keeps the trusted apps' protected files in data/.
Options=rw,nosuid,nodev,noexec
DirectoryMode=0700
