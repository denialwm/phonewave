# Started by the fprintd drop-in of a phone whose boot image's tail has the
# UFF sensor.
[Unit]
Description=Fingerprint sensor calibration from the persist partition
ConditionPathExists=!/var/lib/uff-fingerprint/calibration/fingerprint_cali.bin
DefaultDependencies=no
After=local-fs.target
Before=fprintd.service

[Service]
Type=oneshot
StateDirectory=uff-fingerprint
StateDirectoryMode=0700
ExecStart=/usr/lib/uff-fingerprint/uff-calibration
