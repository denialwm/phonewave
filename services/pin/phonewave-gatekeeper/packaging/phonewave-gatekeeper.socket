# The phone's software PIN provider. Denial and Droidloom use a hardware
# provider's worker.sock where the phone has one, else this socket.
[Unit]
Description=PIN requests for the phone's user

[Socket]
ListenStream=/run/gatekeeper/software.sock
DirectoryMode=0755
SocketUser=root
SocketGroup=gatekeeper
SocketMode=0660
Accept=yes
MaxConnections=4
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
