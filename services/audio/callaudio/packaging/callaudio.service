[Unit]
Description=Call audio: the sound card follows the modem's calls
After=pipewire.service wireplumber.service
Wants=wireplumber.service

[Service]
Type=dbus
BusName=org.callaudio
ExecStart=/usr/bin/callaudio
# Ready once a card with the verb is up, which can take the audio DSP's boot.
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
