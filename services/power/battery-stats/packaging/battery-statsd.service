[Unit]
Description=Battery stats

[Service]
ExecStart=/usr/bin/battery-statsd
Restart=on-failure
RestartSec=5
StateDirectory=battery-stats
StateDirectoryMode=0755
RuntimeDirectory=battery-stats
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0022

[Install]
WantedBy=multi-user.target
