From bba78045c70878f0ebdca885f3f1963c04586430 Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Sun, 1 Nov 2026 23:11:08 +0100
Subject: [PATCH] rpcd: Serve the sensor configuration from /odm too

Some vendors keep the sensor configuration on the odm partition and
point the DSP at /odm/etc/sensors/config. Map it to odm/sensors/config/
under the device directory, empty when that is missing.
---
 hexagonrpcd/rpcd_builder.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/hexagonrpcd/rpcd_builder.c b/hexagonrpcd/rpcd_builder.c
index d374958..a384b43 100644
--- a/hexagonrpcd/rpcd_builder.c
+++ b/hexagonrpcd/rpcd_builder.c
@@ -28,6 +28,7 @@
 // These paths are relative, with a prepended '/' if missing from previous segments
 #define ACDBDATA		"/acdb/"
 #define DSP_LIBS		"/dsp/"
+#define ODM_SENSORS_CONFIG	"/odm/sensors/config/"
 #define SENSORS_CONFIG		"/sensors/config/"
 #define SENSORS_REGISTRY	"/sensors/registry/"
 #define SNS_REG_CONFIG		"/sensors/sns_reg.conf"
@@ -111,13 +112,14 @@ static struct hexagonfs_dirent *hfs_map_or_empty(const char *name, const char *p
  */
 struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 {
-	char *acdbdata, *dsp_libs, *sns_cfg, *sns_reg, *sns_reg_config, *socinfo;
+	char *acdbdata, *dsp_libs, *odm_sns_cfg, *sns_cfg, *sns_reg, *sns_reg_config, *socinfo;
 	size_t n_prefix;
 	struct hexagonfs_dirent *persist_dir, *vendor_dir;
 
 	n_prefix = strlen(prefix);
 
 	acdbdata = malloc(n_prefix + strlen(ACDBDATA) + 1);
+	odm_sns_cfg = malloc(n_prefix + strlen(ODM_SENSORS_CONFIG) + 1);
 	sns_cfg = malloc(n_prefix + strlen(SENSORS_CONFIG) + 1);
 	sns_reg = malloc(n_prefix + strlen(SENSORS_REGISTRY) + 1);
 	sns_reg_config = malloc(n_prefix + strlen(SNS_REG_CONFIG) + 1);
@@ -130,6 +132,11 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 		strcat(acdbdata, ACDBDATA);
 	}
 
+	if (odm_sns_cfg != NULL) {
+		strcpy(odm_sns_cfg, prefix);
+		strcat(odm_sns_cfg, ODM_SENSORS_CONFIG);
+	}
+
 	if (sns_cfg != NULL) {
 		strcpy(sns_cfg, prefix);
 		strcat(sns_cfg, SENSORS_CONFIG);
@@ -182,12 +189,23 @@ struct hexagonfs_dirent *construct_root_dir(const char *prefix, const char *dsp)
 				)
 			);
 
-	return hfs_mkdir("/", 6,
+	return hfs_mkdir("/", 7,
 			hfs_mkdir("mnt", 1,
 				hfs_mkdir("vendor", 1,
 					persist_dir
 				)
 			),
+			/*
+			 * Some vendors keep the sensor configuration on the odm
+			 * partition and point the DSP there.
+			 */
+			hfs_mkdir("odm", 1,
+				hfs_mkdir("etc", 1,
+					hfs_mkdir("sensors", 1,
+						hfs_map_or_empty("config", odm_sns_cfg)
+					)
+				)
+			),
 			persist_dir,
 			hfs_mkdir("sys", 1,
 				hfs_mkdir("devices", 1,
