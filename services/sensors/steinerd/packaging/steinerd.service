[Unit]
Description=Sensor service
After=dbus.service

[Service]
Type=dbus
BusName=org.steinerd
ExecStart=/usr/bin/steinerd
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
# ProtectKernelModules= without hiding /usr/lib/modules, where the boot
# image's tail says how the sensors sit against the screen.
CapabilityBoundingSet=~CAP_SYS_MODULE
SystemCallFilter=~@module
ProtectKernelLogs=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_QIPCRTR
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
