#!/usr/bin/env bash
# Write the built image on a phone that already runs one, without going
# through fastboot. For quick tries; flash.sh is the install.
# Usage: image/install-userdata HOST
#
# The phone runs Linux, or already sits in our init_boot's rescue. Asks the
# installed system for rescue, writes the image over SSH where the early
# userspace boots it from (denial where the phone has one, else userdata),
# reads it back, reboots into it.
set -euo pipefail
cache=${PHONEWAVE_CACHE:-/mnt/development/phonewave-cache}
host=${1:?usage: image/install-userdata HOST}
image=$cache/image/out/userdata.img
# Rescue's dropbear makes new host keys every boot.
phone=(ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR
  -o ConnectTimeout=3 -o ServerAliveInterval=5 -o ServerAliveCountMax=3 "$host")

in_rescue() { "${phone[@]}" "test -e /run/rescue" 2>/dev/null; }

if ! in_rescue; then
  "${phone[@]}" "touch /etc/phone-rescue && sync && systemctl reboot" || true
  echo "rebooting into rescue"
  sleep 10
  for _ in $(seq 30); do in_rescue && break; sleep 3; done
  in_rescue || { echo "no rescue shell on $host" >&2; exit 1; }
fi

# Every phone answers at the same USB address: say which one this is.
echo "$host is $("${phone[@]}" 'tr "\0" "\n" < /proc/device-tree/model')"
for name in denial userdata; do
  part=$("${phone[@]}" "grep -l '^PARTNAME=$name\$' /sys/class/block/*/uevent | cut -d/ -f5")
  [ -z "$part" ] || break
done
[ -n "$part" ] || { echo "no denial or userdata partition" >&2; exit 1; }
raw=$cache/image/out/userdata.raw
simg2img "$image" "$raw"
trap 'rm -f "$raw"' EXIT
size=$(stat -c%s "$raw")
echo "writing $size bytes to /dev/$part ($name)"
gzip -1c "$raw" | "${phone[@]}" "{ ! mountpoint -q /newroot || umount /newroot; } && gunzip -c | dd of=/dev/$part bs=4M 2>/dev/null && sync"
want=$(sha256sum "$raw" | cut -d' ' -f1)
have=$("${phone[@]}" "head -c $size /dev/$part | sha256sum" | cut -d' ' -f1)
[ "$want" = "$have" ] || { echo "read back $have, wrote $want" >&2; exit 1; }
echo "verified; rebooting"
"${phone[@]}" 'reboot -f' || true
