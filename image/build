#!/usr/bin/env bash
# Build the images that install a phone.
# Usage: image/build [--droidloom] [--local-builds] [--dev-access [--setup]]
#
#   --droidloom   include Droidloom
#   --local-builds  Denial and Droidloom from this workstation's newest
#                 tools/build outputs (builds/*/PROJECT/latest), in place of
#                 the published releases. For trying the streams' heads.
#   --dev-access  root's SSH keys from every phone's vault, the vault's shared
#                 image/private-rootfs, the owner's wallpaper, the user logix
#                 and, with --local-builds, droidloom-gapps when the Droidloom
#                 build packed it. Only for images that never leave this
#                 workstation.
#   --setup       with --dev-access, no logix: the phone's setup makes the
#                 account, as on every image without --dev-access.
#
# One image for every phone. Writes $PHONEWAVE_CACHE (default
# /mnt/development/phonewave-cache)/image/out/: userdata.img, the shared
# init_boot.img, flash.sh. Each phone's boot image is its own:
# devices/<codename>/ in Phonewave. Runs without root: a user namespace owns
# the new root, and QEMU runs the ARM install scripts inside it.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
vault=${PHONEWAVE_VAULT:-/mnt/development/denial-os/device-vault}
builds=${DENIAL_BUILDS:-/mnt/development/denial-os/builds}
cache=${PHONEWAVE_CACHE:-/mnt/development/phonewave-cache}
alarm_mirror=http://mirror.archlinuxarm.org
alarm_key=68B3537F39A313B3E574D06777193F152BDBE6A6
denial_key=AE4108FA5E91E26BE0EE331E0F5B3AD16E023091

inside=
[ "${1:-}" = --inside ] && { inside=1; shift; }
droidloom= local_builds= dev_access= setup=
for arg; do
  case $arg in
    --droidloom) droidloom=1 ;;
    --local-builds) local_builds=1 ;;
    --dev-access) dev_access=1 ;;
    --setup) setup=1 ;;
    *) echo "unknown option $arg" >&2; exit 2 ;;
  esac
done
shared=$cache/image
out=$shared/out
qemu=$shared/qemu/usr/bin/qemu-aarch64-static
gnupg=$shared/gnupg
root=$out/root
noextract=$(grep -hv '^\s*\(#\|$\)' "$here/noextract" | tr '\n' ' ')

verify_with() {  # KEYRING FILE: FILE.sig is a good signature by a key in KEYRING
  local home status
  home=$(mktemp -d)
  gpg -q --homedir "$home" --import "$1" 2>/dev/null
  status=$(LANG=C gpg --homedir "$home" --status-fd 1 --verify "$2.sig" "$2" 2>/dev/null || true)
  rm -rf "$home"
  grep -q '^\[GNUPG:\] VALIDSIG ' <<<"$status"
}

host() {
  mkdir -p "$shared/qemu" "$shared/pkg" "$out"

  if [ ! -x "$qemu" ]; then
    local version file
    version=$(curl -sSf https://archlinux.org/packages/extra/x86_64/qemu-user-static/json/ |
      python -c 'import json,sys; d=json.load(sys.stdin); e=d["epoch"]; print((f"{e}:" if e else "") + d["pkgver"] + "-" + d["pkgrel"])')
    file=qemu-user-static-$version-x86_64.pkg.tar.zst
    (cd "$shared/qemu" &&
      curl -sSfLO "https://geo.mirror.pkgbuild.com/extra/os/x86_64/$file" &&
      curl -sSfLO "https://geo.mirror.pkgbuild.com/extra/os/x86_64/$file.sig")
    verify_with /usr/share/pacman/keyrings/archlinux.gpg "$shared/qemu/$file" ||
      { echo "bad signature on $file" >&2; exit 1; }
    bsdtar -xf "$shared/qemu/$file" -C "$shared/qemu" usr/bin/qemu-aarch64-static
  fi

  if [ ! -d "$shared/alarm-keyring" ]; then
    local db file dir
    db=$(mktemp)
    curl -sSfL "$alarm_mirror/aarch64/core/core.db" -o "$db"
    file=$(bsdtar -xOf "$db" --include '*/desc' | awk '/^%FILENAME%$/ { getline; print }' |
      grep '^archlinuxarm-keyring-')
    rm "$db"
    dir=$(mktemp -d)
    curl -sSfL "$alarm_mirror/aarch64/core/$file" -o "$dir/$file"
    curl -sSfL "$alarm_mirror/aarch64/core/$file.sig" -o "$dir/$file.sig"
    bsdtar -xf "$dir/$file" -C "$dir" usr/share/pacman/keyrings
    # The pinned key is the trust anchor: it must be in the package's trusted
    # list and must have signed the package.
    grep -q "^$alarm_key:" "$dir/usr/share/pacman/keyrings/archlinuxarm-trusted" &&
      verify_with "$dir/usr/share/pacman/keyrings/archlinuxarm.gpg" "$dir/$file" ||
      { echo "archlinuxarm-keyring is not signed by $alarm_key" >&2; exit 1; }
    mv "$dir/usr/share/pacman/keyrings" "$shared/alarm-keyring"
    rm -rf "$dir"
  fi

  # Our packages, as a repository listed before Arch's: those image/pack
  # builds.
  rm -rf "$out/repo"
  mkdir -p "$out/repo"
  local name
  for name in $(grep -hv '^\s*\(#\|$\)' "$here/packages/phonewave"); do
    ln "$(ls "$shared/packages/$name"-[0-9]*.pkg.tar.zst | sort -V | tail -1)" "$out/repo/"
  done
  # The repository comes first, so its Denial and Droidloom win over the
  # published ones whatever their versions.
  if [ -n "$local_builds" ]; then
    local project newest
    for project in denial ${droidloom:+droidloom}; do
      newest=$(for l in "$builds"/*/"$project"/latest; do readlink -f "$l"; done |
        awk -F/ '{ print $NF "\t" $0 }' | sort | tail -1 | cut -f2)
      [ -n "$newest" ] || { echo "no $project build in $builds" >&2; exit 1; }
      echo "local $project: $newest"
      ln "$newest"/*.pkg.tar.zst "$out/repo/"
      # The local Google apps add-on is not ours to hand out.
      [ -n "$dev_access" ] || rm -f "$out/repo"/droidloom-gapps-*
    done
  fi
  repo-add -q "$out/repo/phonewave.db.tar.zst" "$out/repo/"*.pkg.tar.zst

  cat > "$out/pacman.conf" <<EOF
[options]
Architecture = aarch64
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional
ParallelDownloads = 5
DisableSandbox
NoExtract = $noextract

[phonewave]
SigLevel = Optional TrustAll
Server = file://$out/repo

[core]
Server = $alarm_mirror/\$arch/\$repo
[extra]
Server = $alarm_mirror/\$arch/\$repo
[alarm]
Server = $alarm_mirror/\$arch/\$repo
[aur]
Server = $alarm_mirror/\$arch/\$repo

[denial]
SigLevel = Required TrustedOnly
Server = https://packages.denialwm.org/arch/\$arch
EOF
  [ -z "$droidloom" ] || droidloom_repo >> "$out/pacman.conf"

  local flags=()
  [ -n "$droidloom" ] && flags+=(--droidloom)
  [ -n "$local_builds" ] && flags+=(--local-builds)
  [ -n "$dev_access" ] && flags+=(--dev-access)
  [ -n "$setup" ] && flags+=(--setup)
  PHONEWAVE_CACHE=$cache PHONEWAVE_VAULT=$vault \
    unshare --map-auto --map-root-user --mount --pid --fork --mount-proc \
    "$0" --inside "${flags[@]}"

  # The init_boot every phone shares.
  "$here/init-boot" "$out/init_boot.img" ${dev_access:+--dev-access}
  cat > "$out/flash.sh" <<'EOF'
#!/bin/sh
# Install this image on any phone from the init_boot's own fastboot, which
# comes up while no denial or userdata partition holds a system, and which a
# root holding /etc/phone-rescue asks for. The root goes where the early
# userspace boots it from: denial where the phone has one, so Android keeps
# userdata, else userdata. The phone's boot image is its own
# (devices/<codename>/ in Phonewave).
# Usage: flash.sh [PACKAGE...]
# Each PACKAGE is a pacman package the phone installs as it first starts,
# such as droidloom-gapps, which has to be there before Android first boots.
set -eu
packages=
for package; do packages="$packages $(realpath "$package")"; done
cd "$(dirname "$0")"
echo "waiting for Denial OS's install screen"
until fastboot getvar denial-install 2>&1 | grep -q '^denial-install: yes'; do sleep 2; done
part=userdata
fastboot getvar partition-size:denial 2>&1 | grep -q '^partition-size:denial: 0x' && part=denial
echo "writing the root to $part"
fastboot flash "$part" userdata.img
for package in $packages; do fastboot flash package "$package"; done
fastboot reboot
EOF
  chmod +x "$out/flash.sh"
  ls -la "$out"
}

# Droidloom's repository: unsigned packages over HTTPS, as Droidloom ships.
droidloom_repo() {
  cat <<'EOF'
[droidloom]
# Droidloom currently publishes unsigned packages over HTTPS.
SigLevel = Never
Server = https://denialwm.github.io/droidloom/aarch64
CacheServer = https://github.com/denialwm/droidloom/releases/download/packages
EOF
}

inside() {
  mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc
  printf '%s' ':qemu-aarch64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\xb7\x00:\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:'"$qemu"':FP' \
    > /proc/sys/fs/binfmt_misc/register

  if ! gpg --homedir "$gnupg" --list-keys "$denial_key" >/dev/null 2>&1; then
    rm -rf "$gnupg"
    pacman-key --gpgdir "$gnupg" --init
    pacman-key --gpgdir "$gnupg" --populate-from "$shared/alarm-keyring" --populate archlinuxarm
    pacman-key --gpgdir "$gnupg" --add "$here/rootfs/usr/share/phonewave-system/denial-repo-key.asc"
    pacman-key --gpgdir "$gnupg" --lsign-key "$denial_key"
  fi

  rm -rf "$root"
  # The install scripts see only the few device nodes they need, never this
  # workstation's devices or /sys.
  mkdir -p "$root"/{dev,proc,run,tmp,etc/pacman.d/hooks,var/lib/pacman}
  mount -t tmpfs -o mode=0755 tmpfs "$root/dev"
  local node
  for node in null zero full random urandom tty; do
    touch "$root/dev/$node"
    mount --bind "/dev/$node" "$root/dev/$node"
  done
  ln -s /proc/self/fd "$root/dev/fd"
  ln -s /proc/self/fd/0 "$root/dev/stdin"
  ln -s /proc/self/fd/1 "$root/dev/stdout"
  ln -s /proc/self/fd/2 "$root/dev/stderr"
  mount -t proc proc "$root/proc"
  mount -t tmpfs -o mode=0755 tmpfs "$root/run"
  mount -t tmpfs tmpfs "$root/tmp"

  local list=()
  mapfile -t list < <(grep -hv '^\s*\(#\|$\)' "$here/packages/base" "$here/packages/phonewave")
  [ -n "$droidloom" ] && list+=(droidloom-runtime droidloom-image)
  [ -n "$droidloom" ] && compgen -G "$out/repo/droidloom-gapps-*" > /dev/null &&
    list+=(droidloom-gapps)
  pacman -r "$root" --config "$out/pacman.conf" --gpgdir "$gnupg" --cachedir "$shared/pkg" \
    --hookdir "$root/etc/pacman.d/hooks" --logfile "$out/pacman.log" \
    -Sy --noconfirm "${list[@]}"
  # This workstation's pacman may write fields the phone's does not know
  # (CachyOS's %INSTALLED_DB%), which then warns on every command. The phone's
  # own pacman rewrites each entry; it writes one only when the install
  # reason changes, so each package is flipped and flipped back.
  local explicit=() deps=()
  mapfile -t explicit < <(chroot "$root" pacman -Qqe 2>/dev/null)
  mapfile -t deps < <(chroot "$root" pacman -Qqd 2>/dev/null)
  {
    chroot "$root" pacman -D --asdeps "${explicit[@]}"
    chroot "$root" pacman -D --asexplicit "${explicit[@]}"
    if [ ${#deps[@]} -gt 0 ]; then
      chroot "$root" pacman -D --asexplicit "${deps[@]}"
      chroot "$root" pacman -D --asdeps "${deps[@]}"
    fi
  } > /dev/null 2>&1
  ! grep -lq '^%INSTALLED_DB%$' "$root"/var/lib/pacman/local/*/desc ||
    { echo "the phone's pacman left fields it does not know" >&2; exit 1; }

  # The partition layout, the one system file not in a package: fstab
  # belongs to the filesystem package, and every install sets its own. The
  # root is this image's filesystem, whichever partition holds it.
  local uuid
  uuid=$(cat /proc/sys/kernel/random/uuid)
  sed "s/@ROOT_UUID@/$uuid/" "$here/fstab" > "$root/etc/fstab"
  # Empty: the boot image carries the kernel's modules and the early
  # userspace mounts them here.
  install -d "$root/usr/lib/modules"

  # The phone's pacman.conf: Arch Linux ARM's, with the Denial repositories:
  # Denial itself, and denial-phone with what image/pack builds.
  sed -i -e "/^#NoExtract/a NoExtract = $noextract" "$root/etc/pacman.conf"
  printf '\n[denial]\nSigLevel = Required TrustedOnly\nServer = https://packages.denialwm.org/arch/$arch\n' \
    >> "$root/etc/pacman.conf"
  printf '\n[denial-phone]\nSigLevel = Required TrustedOnly\nServer = https://packages.denialwm.org/phone/$arch\n' \
    >> "$root/etc/pacman.conf"
  # Droidloom's repository as its install.sh writes it, which then accepts it.
  if [ -n "$droidloom" ]; then
    droidloom_repo > "$root/etc/pacman.d/droidloom.conf"
    printf '\nInclude = /etc/pacman.d/droidloom.conf\n' >> "$root/etc/pacman.conf"
  fi

  # Nothing that belongs to one phone: each makes its own on first boot.
  : > "$root/etc/machine-id"
  rm -rf "$root"/etc/ssh/ssh_host_* "$root/etc/pacman.d/gnupg" "$root"/var/lib/pacman/sync/*
  rm -f "$root/etc/.updated" "$root/var/.updated"
  echo LANG=C.UTF-8 > "$root/etc/locale.conf"
  touch "$root/usr/lib/clock-epoch"

  if [ -n "$dev_access" ]; then
    # Root's keys from every phone's vault, as the init_boot's rescue takes
    # them, and what every phone shares (the Wi-Fi network). A phone's own
    # SSH host keys stay in its vault; the image's are made on first boot.
    install -d -m700 "$root/root/.ssh"
    cat "$vault"/*/private-rootfs/root/.ssh/authorized_keys | sort -u > "$root/root/.ssh/authorized_keys"
    chmod 600 "$root/root/.ssh/authorized_keys"
    cp -a "$vault/image/private-rootfs/etc/." "$root/etc/"
    # The owner's wallpaper, kept out of every package (vault image/wallpaper/
    # README.md), and the lock screen's depth mask made for it, which Denial
    # makes only when the wallpaper picker closes.
    wallpaper=$vault/image/wallpaper
    (cd "$wallpaper" && sha256sum -c --quiet SHA256SUMS)
    install -Dm644 -t "$root/usr/local/share/backgrounds" "$wallpaper/wallhaven-e8v3mo.jpg"
    install -Dm644 "$wallpaper/wallpaper.json" "$root/etc/skel/.local/state/denial/wallpaper"
    install -Dm644 -t "$root/etc/skel/.cache/denial/wallpaper-depth" "$wallpaper"/wallpaper-depth/*
  fi
  if [ -n "$dev_access" ] && [ -z "$setup" ]; then
    chroot "$root" useradd -m -u 1000 -U \
      -G "$(grep -v '^#' "$root/usr/lib/phonewave-system/user-groups" | paste -sd,)" logix
    # What first-user writes for the account it makes.
    install -Dm644 /dev/stdin "$root/etc/systemd/system/denial.service.d/user.conf" <<'EOF'
[Service]
User=logix
Group=logix
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
EOF
  else
    # No person's account yet: Denial starts as denial-setup (phonewave-system's
    # sysusers.d) and shows its setup, which makes one with first-user.
    chroot "$root" /usr/lib/phonewave-system/setup-session
  fi

  umount -R "$root/dev" "$root/proc" "$root/run" "$root/tmp"
  mkdir -p "$root/sys"
  chmod 0755 "$root/dev" "$root/run"
  chmod 0555 "$root/proc" "$root/sys"
  chmod 1777 "$root/tmp"

  # Content plus a quarter, rounded to MiB. First boot grows it.
  local size
  size=$(du -s -B1M "$root" | cut -f1)
  size=$((size + size / 4 + 256))
  rm -f "$out/userdata.raw" "$out/userdata.img"
  mkfs.ext4 -q -F -i 8192 -U "$uuid" -d "$root" "$out/userdata.raw" "${size}M"
  img2simg "$out/userdata.raw" "$out/userdata.img"
  rm "$out/userdata.raw"
}

if [ -n "$inside" ]; then inside; else host; fi
