#!/bin/busybox sh
# The early userspace every phone's init_boot carries; image/init-boot packs
# it with the device's /etc/phone.conf, which names the phone (codename,
# product), its USB addresses (host_addr, dev_addr) and rescue_flag; in a
# rescue init_boot, stay_in_rescue.
#
# The bootloader loads it from init_boot_b and passes it after the
# vendor_boot ramdisk, which only holds Android kernel modules; switch_root
# frees both.
#
# Brings up the USB gadget (ECM network + ACM serial), mounts the Arch root
# read-only and hands over to systemd, which checks it and remounts it
# read-write from fstab. The root is the first of the partitions denial and
# userdata that holds a Phonewave root, marked by phonewave-system's
# /usr/lib/phonewave-system/root. The gadget stays bound; the installed
# system gives usb0 its address (10.77.71.2) and SSH.
#
# If neither holds one, or the root contains rescue_flag, or phone.conf sets
# stay_in_rescue, this stays as PID 1 in rescue: fastboot, which writes
# denial or userdata, SSH at 10.77.71.2 and a shell on ttyGS0, and on the
# bootloader's framebuffer why and how to install.
#
# There is no firmware here: the drivers that need it are modules. The boot
# partition carries them, after the kernel, as an erofs filesystem that is
# mounted in place at /usr/lib/modules, with the firmware that overrides
# the installed system's and the units the kernel needs. Its
# libexec/stock-firmware binds in the vendor firmware from the slot's own
# partitions; if a required file is missing, this stays in rescue.
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /sys/kernel/config /sys/fs/pstore
mount -t tmpfs -o mode=0755 tmpfs /run
mount -t configfs configfs /sys/kernel/config
exec </dev/null >>/dev/kmsg 2>&1
. /etc/phone.conf
mark() { echo "phone-init: $*" > /dev/kmsg; }
mark "started on $(uname -r)"

g=/sys/kernel/config/usb_gadget/phone
mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409 $g/functions/acm.usb0 $g/functions/ecm.usb0
echo 0x1d6b > $g/idVendor
echo 0x0104 > $g/idProduct
echo 0x0200 > $g/bcdUSB
echo 0x0200 > $g/bcdDevice
echo "$codename-$(uname -r)" > $g/strings/0x409/serialnumber
echo 'Linux' > $g/strings/0x409/manufacturer
echo "$product" > $g/strings/0x409/product
echo 'ACM serial + ECM network' > $g/configs/c.1/strings/0x409/configuration
echo 100 > $g/configs/c.1/MaxPower
echo $host_addr > $g/functions/ecm.usb0/host_addr
echo $dev_addr > $g/functions/ecm.usb0/dev_addr
ln -s $g/functions/ecm.usb0 $g/configs/c.1/ecm.usb0
ln -s $g/functions/acm.usb0 $g/configs/c.1/acm.usb0

# UFS LUNs attach asynchronously and their sdX names change between boots.
part() {
	for b in /sys/class/block/sd*; do
		grep -qx "PARTNAME=$1" $b/uevent 2>/dev/null && { echo /dev/${b##*/}; return 0; }
	done
	return 1
}

# The reason goes on the screen too: a line of at most 36 characters.
rescue() {
	mark "rescue: $*"
	touch /run/rescue
	mkdir -p $g/functions/ffs.fastboot /dev/usb-ffs/fastboot
	ln -s $g/functions/ffs.fastboot $g/configs/c.1/ffs.fastboot
	mount -t functionfs fastboot /dev/usb-ffs/fastboot &&
		fastboot /dev/usb-ffs/fastboot "$product" "$(cat $g/strings/0x409/serialnumber)" "$*" ||
		{ mark "rescue: no fastboot"; rm $g/configs/c.1/ffs.fastboot; }
	udc=
	for i in $(seq 30); do
		udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
		[ -n "$udc" ] && break
		sleep 1
	done
	[ -n "$udc" ] && [ -z "$(cat $g/UDC)" ] && echo "$udc" > $g/UDC
	ifname=$(cat $g/functions/ecm.usb0/ifname)
	ip link set lo up
	ip address add 10.77.71.2/30 dev "$ifname"
	ip link set "$ifname" up
	mkdir -p /etc/dropbear
	dropbearmulti dropbear -R -E -p 10.77.71.2:22 -P /run/dropbear.pid
	mark "rescue SSH on $ifname at 10.77.71.2 (rc=$?)"
	mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
	mount -t pstore pstore /sys/fs/pstore 2>/dev/null
	while :; do
		[ -c /dev/ttyGS0 ] && setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'
		sleep 2
	done
}

denial= userdata=
for i in $(seq 30); do
	denial=$(part denial)
	userdata=$(part userdata)
	[ -n "$denial$userdata" ] && break
	sleep 1
done
[ -n "$denial$userdata" ] || rescue "No denial or userdata partition"
root=
for p in $denial $userdata; do
	mount -t ext4 -o ro $p /newroot 2>/dev/null || continue
	[ -e /newroot/usr/lib/phonewave-system/root ] && { root=$p; break; }
	umount /newroot
done
[ -n "$root" ] || rescue "No system installed"
[ -z "$stay_in_rescue" ] || rescue "This init_boot stops in rescue"
[ -e /newroot$rescue_flag ] && rescue "Rescue requested by the system"
[ -x /newroot/usr/lib/systemd/systemd ] || rescue "No systemd on ${root#/dev/}"

# The boot partition with this kernel's modules: its filesystem starts at the
# page after the kernel, whose size is in the header. Whichever slot holds
# a folder named after the running kernel is the one that booted.
modules() {
	release=$(uname -r)
	for b in /sys/class/block/sd*; do
		grep -qx 'PARTNAME=boot\(_[ab]\)\{0,1\}' $b/uevent 2>/dev/null || continue
		boot=/dev/${b##*/}
		size=$(dd if=$boot bs=4 skip=2 count=1 2>/dev/null | od -An -tu4 | tr -d ' ')
		[ -n "$size" ] || continue
		mount -t erofs -o ro,fsoffset=$(( (size + 4095) / 4096 * 4096 + 4096 )) $boot /newroot/usr/lib/modules 2>/dev/null || continue
		[ -d /newroot/usr/lib/modules/$release ] &&
			slot=$(sed -n 's/^PARTNAME=boot//p' $b/uevent) && return 0
		umount /newroot/usr/lib/modules
	done
	return 1
}
if modules; then
	echo -n /usr/lib/modules/$release/firmware > /sys/module/firmware_class/parameters/path
	units=/newroot/usr/lib/modules/$release/systemd/system
	[ -d $units ] && mkdir -p /run/systemd/system && cp -a $units/. /run/systemd/system/
	mark "modules of $release from $boot"
	fw=/newroot/usr/lib/modules/$release/libexec/stock-firmware
	[ ! -x $fw ] || $fw /newroot/usr/lib/modules/$release "$slot" ||
		rescue "Required stock firmware missing"
else
	mark "no boot partition holds the modules of $release"
fi

# Bind the gadget now: the host sees the phone during the whole boot.
for i in $(seq 10); do
	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	[ -n "$udc" ] && { echo "$udc" > $g/UDC; break; }
	sleep 1
done
mark "root $root, gadget on ${udc:-no UDC}; starting systemd"
for m in /dev /proc /sys /run; do
	mount --move $m /newroot$m
done
exec switch_root /newroot /usr/lib/systemd/systemd
