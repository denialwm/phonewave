# What every image installs, as this package's dependencies: a phone made from
# an older image gets what the image added since with pacman -Syu. The lists
# are image/packages; phonewave-system, which every phone has, depends on this
# one. Build: image/pack phonewave-image
pkgname=phonewave-image
pkgdesc='Phonewave: the packages every phone image has'
license=(MIT)
_src=$startdir/../../packages
. "$startdir/../recipe.sh"
arch=(any)
# A package of ours that replaces an Arch one is asked for by Arch's name,
# which it provides: on a phone that has Arch's, the dependency holds and
# pacman -Syu swaps it through replaces, with no conflict to answer; the
# image installs ours from the lists.
_name() {
  local replaces
  replaces=$(sed -n 's/^replaces=(\([^ )]*\))$/\1/p' "$startdir/../$1/PKGBUILD" 2>/dev/null)
  echo "${replaces:-$1}"
}
depends=($(grep -hv '^\s*\(#\|$\)' "$_src/base" "$_src/phonewave" |
  grep -vx -e "$pkgname" -e phonewave-system | while read -r p; do _name "$p"; done))

package() {
  :
}
