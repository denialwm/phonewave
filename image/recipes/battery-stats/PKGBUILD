# Phonewave's battery-stats (services/power/battery-stats) for the phones. Build: image/pack battery-stats
pkgname=battery-stats
pkgdesc='Battery statistics by phone state'
license=(MIT)
_src=$startdir/../../../services/power/battery-stats
. "$startdir/../recipe.sh"
depends=(glibc gcc-libs dbus)

build() {
  make -C "$_src" TARGET=$TARGET
}

package() {
  make -C "$_src" install TARGET=$TARGET DESTDIR="$pkgdir"
}
