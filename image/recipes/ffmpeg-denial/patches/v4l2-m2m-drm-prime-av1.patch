-    capture->av_pix_fmt = avctx->pix_fmt;
+    ret = v4l2_choose_format(avctx, s);
+    if (ret) {
+        av_log(avctx, AV_LOG_ERROR, "no usable output format\n");
+        return ret;
+    }
 
     /* 3. set the crop parameters */
     selection.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
@@ -87,8 +122,10 @@ static int v4l2_try_start(AVCodecContext *avctx)
     if (!capture->buffers) {
         ret = ff_v4l2_context_init(capture);
         if (ret) {
-            av_log(avctx, AV_LOG_ERROR, "can't request capture buffers\n");
-            return AVERROR(ENOMEM);
+            /* The driver may have found the stream's format after G_FMT,
+             * such as a 10-bit one; try again with the next packet. */
+            av_log(avctx, AV_LOG_DEBUG, "capture buffers not ready\n");
+            return 0;
         }
     }
 
@@ -230,6 +267,11 @@ static const AVOption options[] = {
     { NULL},
 };
 
+static const AVCodecHWConfigInternal *const v4l2_m2m_hw_configs[] = {
+    HW_CONFIG_INTERNAL(DRM_PRIME),
