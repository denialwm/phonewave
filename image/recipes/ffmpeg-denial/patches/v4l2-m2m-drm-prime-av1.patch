diff --git a/libavcodec/v4l2_buffers.c b/libavcodec/v4l2_buffers.c
index 3b79152..778ea9e 100644
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -39,6 +39,10 @@
 #define USEC_PER_SEC 1000000
 #endif
 
+#define V4L2_DRM_FOURCC(a, b, c, d) \
+    ((uint32_t)(a) | ((uint32_t)(b) << 8) | ((uint32_t)(c) << 16) | ((uint32_t)(d) << 24))
+#define V4L2_DRM_FORMAT_MOD_LINEAR 0
+
 static AVRational v4l2_timebase = { 1, USEC_PER_SEC };
 
 static inline V4L2m2mContext *buf_to_m2mctx(V4L2Buffer *buf)
@@ -59,7 +63,10 @@ static inline AVRational v4l2_get_timebase(V4L2Buffer *avbuf)
 
     if (s->avctx->pkt_timebase.num)
         return s->avctx->pkt_timebase;
-    return s->avctx->time_base;
+    if (s->avctx->time_base.num)
+        return s->avctx->time_base;
+    /* no time base set, as by Firefox: timestamps pass through unchanged */
+    return v4l2_timebase;
 }
 
 static inline void v4l2_set_pts(V4L2Buffer *out, int64_t pts)
@@ -338,6 +345,7 @@ static int v4l2_buffer_buf_to_swframe(AVFrame *frame, V4L2Buffer *avbuf)
     switch (avbuf->context->av_pix_fmt) {
     case AV_PIX_FMT_NV12:
     case AV_PIX_FMT_NV21:
+    case AV_PIX_FMT_P010:
         if (avbuf->num_planes > 1)
             break;
         frame->linesize[1] = avbuf->plane_info[0].bytesperline;
@@ -360,6 +368,117 @@ static int v4l2_buffer_buf_to_swframe(AVFrame *frame, V4L2Buffer *avbuf)
     return 0;
 }
 
+static int v4l2_buffer_buf_to_drmframe(AVFrame *frame, V4L2Buffer *avbuf)
+{
+    int ret;
+
+    frame->buf[0] = av_buffer_create((uint8_t *)&avbuf->drm_frame,
+                                     sizeof(avbuf->drm_frame), v4l2_free_buffer,
+                                     avbuf, AV_BUFFER_FLAG_READONLY);
+    if (!frame->buf[0])
+        return AVERROR(ENOMEM);
+
+    ret = v4l2_buf_increase_ref(avbuf);
+    if (ret)
+        return ret;
+
+    frame->data[0] = frame->buf[0]->data;
+    frame->format = AV_PIX_FMT_DRM_PRIME;
+
+    return 0;
+}
+
+uint32_t ff_v4l2_buffer_drm_format(uint32_t v4l2_fmt)
+{
+    switch (v4l2_fmt) {
+    case V4L2_PIX_FMT_NV12:
+#ifdef V4L2_PIX_FMT_NV12M
+    case V4L2_PIX_FMT_NV12M:
+#endif
+        return V4L2_DRM_FOURCC('N', 'V', '1', '2');
+#ifdef V4L2_PIX_FMT_P010
+    case V4L2_PIX_FMT_P010:
+        return V4L2_DRM_FOURCC('P', '0', '1', '0');
+#endif
+    case V4L2_PIX_FMT_YUV420:
+#ifdef V4L2_PIX_FMT_YUV420M
+    case V4L2_PIX_FMT_YUV420M:
+#endif
+        return V4L2_DRM_FOURCC('Y', 'U', '1', '2');
+    }
+
+    return 0;
+}
+
+/* Exports each memory plane as a dma-buf and describes the picture in them. */
+static int v4l2_buffer_export_drm(V4L2Buffer *avbuf)
+{
+    V4L2Context *ctx = avbuf->context;
+    AVDRMFrameDescriptor *desc = &avbuf->drm_frame;
+    AVDRMLayerDescriptor *layer = &desc->layers[0];
+    int mplane = V4L2_TYPE_IS_MULTIPLANAR(ctx->type);
+    uint32_t pixfmt = mplane ? ctx->format.fmt.pix_mp.pixelformat :
+                               ctx->format.fmt.pix.pixelformat;
+    int height = mplane ? ctx->format.fmt.pix_mp.height : ctx->format.fmt.pix.height;
+    int pitch = avbuf->plane_info[0].bytesperline;
+    int i, nb_planes;
+
+    layer->format = ff_v4l2_buffer_drm_format(pixfmt);
+    if (!layer->format)
+        return AVERROR(EINVAL);
+
+    for (i = 0; i < avbuf->num_planes; i++) {
+        struct v4l2_exportbuffer exp = {
+            .type  = ctx->type,
+            .index = avbuf->buf.index,
+            .plane = i,
+            .flags = O_RDWR,
+        };
+
+        if (ioctl(buf_to_m2mctx(avbuf)->fd, VIDIOC_EXPBUF, &exp) < 0)
+            return AVERROR(errno);
+        fcntl(exp.fd, F_SETFD, FD_CLOEXEC);
+
+        desc->objects[i].fd = exp.fd;
+        desc->objects[i].size = avbuf->plane_info[i].length;
+        desc->objects[i].format_modifier = V4L2_DRM_FORMAT_MOD_LINEAR;
+        desc->nb_objects = i + 1;
+    }
+
+    nb_planes = layer->format == V4L2_DRM_FOURCC('Y', 'U', '1', '2') ? 3 : 2;
+    desc->nb_layers = 1;
+    layer->nb_planes = nb_planes;
+
+    if (avbuf->num_planes > 1) {
+        /* one memory plane per picture plane */
+        if (avbuf->num_planes != nb_planes)
+            return AVERROR(EINVAL);
+        for (i = 0; i < nb_planes; i++) {
+            layer->planes[i].object_index = i;
+            layer->planes[i].offset = 0;
+            layer->planes[i].pitch = avbuf->plane_info[i].bytesperline;
+        }
+        return 0;
+    }
+
+    /* the picture planes follow each other in one memory plane */
+    layer->planes[0].object_index = 0;
+    layer->planes[0].offset = 0;
+    layer->planes[0].pitch = pitch;
+    layer->planes[1].object_index = 0;
+    layer->planes[1].offset = (ptrdiff_t)pitch * height;
+    if (nb_planes == 3) {
+        layer->planes[1].pitch = pitch / 2;
+        layer->planes[2].object_index = 0;
+        layer->planes[2].offset = layer->planes[1].offset + (ptrdiff_t)(pitch / 2) * (height / 2);
+        layer->planes[2].pitch = pitch / 2;
+    } else {
+        layer->planes[1].pitch = pitch;
+    }
+
+    return 0;
+}
+
 static int v4l2_buffer_swframe_to_buf(const AVFrame *frame, V4L2Buffer *out)
 {
     int i, ret;
@@ -445,7 +564,10 @@ int ff_v4l2_buffer_buf_to_avframe(AVFrame *frame, V4L2Buffer *avbuf)
     av_frame_unref(frame);
 
     /* 1. get references to the actual data */
-    ret = v4l2_buffer_buf_to_swframe(frame, avbuf);
+    if (buf_to_m2mctx(avbuf)->output_drm)
+        ret = v4l2_buffer_buf_to_drmframe(frame, avbuf);
+    else
+        ret = v4l2_buffer_buf_to_swframe(frame, avbuf);
     if (ret)
         return ret;
 
@@ -570,6 +692,12 @@ int ff_v4l2_buffer_initialize(V4L2Buffer* avbuf, int index)
     if (V4L2_TYPE_IS_OUTPUT(ctx->type))
         return 0;
 
+    if (buf_to_m2mctx(avbuf)->output_drm) {
+        ret = v4l2_buffer_export_drm(avbuf);
+        if (ret < 0)
+            return ret;
+    }
+
     if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
         avbuf->buf.m.planes = avbuf->planes;
         avbuf->buf.length   = avbuf->num_planes;
