diff --git a/libavcodec/v4l2_m2m_dec.c b/libavcodec/v4l2_m2m_dec.c
index ba1fe76..468dfde 100644
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -29,11 +29,43 @@
 #include "libavcodec/avcodec.h"
 #include "codec_internal.h"
 #include "libavcodec/decode.h"
+#include "hwconfig.h"
 
 #include "v4l2_context.h"
 #include "v4l2_m2m.h"
 #include "v4l2_fmt.h"
 
+/* Offers the capture format as DRM PRIME frames, where it has a DRM fourcc,
+ * and as software frames; get_format picks. */
+static int v4l2_choose_format(AVCodecContext *avctx, V4L2m2mContext *s)
+{
+    V4L2Context *const capture = &s->capture;
+    uint32_t v4l2_fmt = capture->format.fmt.pix_mp.pixelformat;
+    enum AVPixelFormat sw_fmt = ff_v4l2_format_v4l2_to_avfmt(v4l2_fmt, AV_CODEC_ID_RAWVIDEO);
+    enum AVPixelFormat fmts[3];
+    int n = 0;
+
+    if (ff_v4l2_buffer_drm_format(v4l2_fmt))
+        fmts[n++] = AV_PIX_FMT_DRM_PRIME;
+    if (sw_fmt != AV_PIX_FMT_NONE)
+        fmts[n++] = sw_fmt;
+    fmts[n] = AV_PIX_FMT_NONE;
+
+    capture->av_pix_fmt = sw_fmt;
+    s->output_drm = 0;
+    if (!n) {
+        avctx->pix_fmt = AV_PIX_FMT_NONE;
+        return 0;
+    }
+
+    avctx->pix_fmt = ff_get_format(avctx, fmts);
+    if (avctx->pix_fmt == AV_PIX_FMT_NONE)
+        return AVERROR(EINVAL);
+    s->output_drm = avctx->pix_fmt == AV_PIX_FMT_DRM_PRIME;
+
+    return 0;
+}
+
 static int v4l2_try_start(AVCodecContext *avctx)
 {
     V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
@@ -63,8 +95,11 @@ static int v4l2_try_start(AVCodecContext *avctx)
     }
 
     /* 2.1 update the AVCodecContext */
