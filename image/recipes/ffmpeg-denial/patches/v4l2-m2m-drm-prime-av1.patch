+ *
+ * @returns the DRM fourcc, 0 if the format has none
+ */
+uint32_t ff_v4l2_buffer_drm_format(uint32_t v4l2_fmt);
+
 /**
  * Extracts the data from a V4L2Buffer to an AVFrame
  *
diff --git a/libavcodec/v4l2_context.c b/libavcodec/v4l2_context.c
index be1df37..3d34dea 100644
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -85,12 +85,16 @@ static AVRational v4l2_get_sar(V4L2Context *ctx)
 static inline unsigned int v4l2_resolution_changed(V4L2Context *ctx, struct v4l2_format *fmt2)
 {
     struct v4l2_format *fmt1 = &ctx->format;
+    /* a new pixel format at the same size, such as a 10-bit stream, needs
+     * new buffers too */
     int ret =  V4L2_TYPE_IS_MULTIPLANAR(ctx->type) ?
         fmt1->fmt.pix_mp.width != fmt2->fmt.pix_mp.width ||
-        fmt1->fmt.pix_mp.height != fmt2->fmt.pix_mp.height
+        fmt1->fmt.pix_mp.height != fmt2->fmt.pix_mp.height ||
+        fmt1->fmt.pix_mp.pixelformat != fmt2->fmt.pix_mp.pixelformat
         :
         fmt1->fmt.pix.width != fmt2->fmt.pix.width ||
-        fmt1->fmt.pix.height != fmt2->fmt.pix.height;
+        fmt1->fmt.pix.height != fmt2->fmt.pix.height ||
+        fmt1->fmt.pix.pixelformat != fmt2->fmt.pix.pixelformat;
 
     if (ret)
         av_log(logger(ctx), AV_LOG_DEBUG, "%s changed (%dx%d) -> (%dx%d)\n",
@@ -202,8 +206,20 @@ static int v4l2_handle_event(V4L2Context *ctx)
     }
 
     if (v4l2_resolution_changed(&s->capture, &cap_fmt)) {
-        s->capture.height = v4l2_get_height(&cap_fmt);
-        s->capture.width = v4l2_get_width(&cap_fmt);
+        /* the picture's visible size, where the driver reports it; the
+         * format's is that of the buffers, often taller */
+        struct v4l2_selection sel = {
+            .type = V4L2_BUF_TYPE_VIDEO_CAPTURE,
+            .target = V4L2_SEL_TGT_COMPOSE,
+        };
+
+        if (!ioctl(s->fd, VIDIOC_G_SELECTION, &sel) && sel.r.width && sel.r.height) {
+            s->capture.height = sel.r.height;
+            s->capture.width = sel.r.width;
+        } else {
+            s->capture.height = v4l2_get_height(&cap_fmt);
+            s->capture.width = v4l2_get_width(&cap_fmt);
+        }
         s->capture.sample_aspect_ratio = v4l2_get_sar(&s->capture);
     } else {
         v4l2_start_decode(ctx);
@@ -459,6 +475,10 @@ static int v4l2_release_buffers(V4L2Context* ctx)
                 if (munmap(p->mm_addr, p->length) < 0)
                     av_log(logger(ctx), AV_LOG_ERROR, "%s unmap plane (%s))\n", ctx->name, av_err2str(AVERROR(errno)));
         }
+
+        for (j = 0; j < buffer->drm_frame.nb_objects; j++)
+            close(buffer->drm_frame.objects[j].fd);
+        buffer->drm_frame.nb_objects = 0;
     }
 
     return ioctl(ctx_to_m2mctx(ctx)->fd, VIDIOC_REQBUFS, &req);
@@ -633,15 +653,28 @@ int ff_v4l2_context_dequeue_frame(V4L2Context* ctx, AVFrame* frame, int timeout)
      *  1. decoded frame available
      *  2. an input buffer is ready to be dequeued
      */
-    avbuf = v4l2_dequeue_v4l2buf(ctx, timeout);
-    if (!avbuf) {
-        if (ctx->done)
-            return AVERROR_EOF;
+    for (;;) {
+        avbuf = v4l2_dequeue_v4l2buf(ctx, timeout);
+        if (!avbuf) {
+            if (ctx->done)
+                return AVERROR_EOF;
 
-        return AVERROR(EAGAIN);
-    }
+            return AVERROR(EAGAIN);
+        }
+
+        /* an empty buffer marked as an error holds no picture, such as a
+         * frame the stream decodes but does not show: give it back */
+        if ((avbuf->buf.flags & V4L2_BUF_FLAG_ERROR) &&
+            !(V4L2_TYPE_IS_MULTIPLANAR(avbuf->buf.type) ?
+              avbuf->buf.m.planes[0].bytesused : avbuf->buf.bytesused)) {
+            int ret = ff_v4l2_buffer_enqueue(avbuf);
+            if (ret < 0)
+                return ret;
+            continue;
+        }
 
-    return ff_v4l2_buffer_buf_to_avframe(frame, avbuf);
+        return ff_v4l2_buffer_buf_to_avframe(frame, avbuf);
+    }
 }
 
 int ff_v4l2_context_dequeue_packet(V4L2Context* ctx, AVPacket* pkt)
