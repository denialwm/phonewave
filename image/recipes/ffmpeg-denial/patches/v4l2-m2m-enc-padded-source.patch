From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Travis Geisinger <travis@geisinger.dev>
Date: Sun, 22 Nov 2026 23:29:00 -0500
Subject: [PATCH] avcodec/v4l2_m2m_enc: padded source formats and an empty
 stream

The encoders copied each plane of a frame as linesize times the format's
height and ignored the format's stride. A driver that pads the source
format beyond the frame, as Iris aligns NV12 to 128 x 32 (3840x2160 is
set up as 3840x2176), made the copy read past the frame's planes, which
crashes at 2160 lines, and a stride other than the frame's sheared the
picture (1366 wide). Lay the planes out at the format's stride and
height and copy the frame's own rows into them.

An end of stream before the first frame, as when the muxer fails to
start, sent V4L2_ENC_CMD_STOP to queues that were not streaming and then
waited for a last capture buffer forever. Nothing is queued then: end
at once.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libavcodec/v4l2_buffers.c | 49 +++++++++++++++++++++++++++++++++------
 libavcodec/v4l2_m2m_enc.c |  8 +++++++
 2 files changed, 50 insertions(+), 7 deletions(-)

diff --git a/libavcodec/v4l2_buffers.c b/libavcodec/v4l2_buffers.c
index 778ea9e..2420a7f 100644
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -28,6 +28,7 @@
 #include <fcntl.h>
 #include <poll.h>
 #include "libavcodec/avcodec.h"
+#include "libavutil/imgutils.h"
 #include "libavutil/attributes.h"
 #include "libavutil/pixdesc.h"
 #include "libavutil/refstruct.h"
@@ -515,22 +516,56 @@ static int v4l2_buffer_swframe_to_buf(const AVFrame *frame, V4L2Buffer *out)
 
     if (!is_planar_format) {
         const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(frame->format);
+        int bytesperline = V4L2_TYPE_IS_MULTIPLANAR(fmt.type) ?
+                           fmt.fmt.pix_mp.plane_fmt[0].bytesperline :
+                           fmt.fmt.pix.bytesperline;
+        int dst_linesize[4] = { 0 };
+        unsigned int length = out->plane_info[0].length;
+        size_t offset = 0;
         int planes_nb = 0;
-        int offset = 0;
+
+        if (!desc || frame->height > height)
+            return AVERROR(EINVAL);
 
         for (i = 0; i < desc->nb_components; i++)
             planes_nb = FFMAX(planes_nb, desc->comp[i].plane + 1);
 
+        /*
+         * The driver may pad the format beyond the frame, as Iris aligns
+         * NV12 to 128 x 32: lay the planes out at the format's stride and
+         * height, and copy the frame's own rows into them.
+         */
+        if (!bytesperline)
+            bytesperline = frame->linesize[0];
+        ret = av_image_fill_linesizes(dst_linesize, frame->format,
+                                      bytesperline / FFMAX(desc->comp[0].step, 1));
+        if (ret < 0)
+            return ret;
+
         for (i = 0; i < planes_nb; i++) {
-            int size, h = height;
+            int h = height, rows = frame->height;
+            int bytewidth = av_image_get_linesize(frame->format, frame->width, i);
+
             if (i == 1 || i == 2) {
                 h = AV_CEIL_RSHIFT(h, desc->log2_chroma_h);
+                rows = AV_CEIL_RSHIFT(rows, desc->log2_chroma_h);
             }
-            size = frame->linesize[i] * h;
-            ret = v4l2_bufref_to_buf(out, 0, frame->data[i], size, offset);
-            if (ret)
-                return ret;
-            offset += size;
+            if (bytewidth < 0 || bytewidth > dst_linesize[i] ||
+                offset + (size_t)dst_linesize[i] * h > length)
+                return AVERROR(EINVAL);
+
+            av_image_copy_plane((uint8_t *)out->plane_info[0].mm_addr + offset,
+                                dst_linesize[i], frame->data[i], frame->linesize[i],
+                                bytewidth, rows);
+            offset += (size_t)dst_linesize[i] * h;
+        }
+
+        if (V4L2_TYPE_IS_MULTIPLANAR(out->buf.type)) {
+            out->planes[0].bytesused = offset;
+            out->planes[0].length = length;
+        } else {
+            out->buf.bytesused = offset;
+            out->buf.length = length;
         }
         return 0;
     }
diff --git a/libavcodec/v4l2_m2m_enc.c b/libavcodec/v4l2_m2m_enc.c
index 93703cc..98c125c 100644
--- a/libavcodec/v4l2_m2m_enc.c
+++ b/libavcodec/v4l2_m2m_enc.c
@@ -304,6 +304,14 @@ static int v4l2_receive_packet(AVCodecContext *avctx, AVPacket *avpkt)
             frame = NULL;
     }
 
+    /*
+     * End of stream before any frame: nothing to drain. The driver would
+     * neither start a drain on queues that are not streaming nor ever
+     * return a last buffer, so waiting for one would block for good.
+     */
+    if (!frame && !output->streamon)
+        return AVERROR_EOF;
+
     ret = v4l2_send_frame(avctx, frame);
     if (ret != AVERROR(EAGAIN))
         av_frame_unref(frame);
-- 
2.56.0

