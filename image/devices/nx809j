# Nubia RedMagic 11 Pro. Sourced by image/build.

# The device's own packages, found in packages/ of the device's image cache.
packages=()

# The boot image in the vault's boot/, until the image builds its own.
boot_img=boot-233-fingerprint.img
# The stock bootloader's fastboot writes nothing: flash.sh starts at the
# init_boot's rescue.
bootloader_flash=no
ssh_host=nx809j
