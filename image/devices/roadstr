# Motorola Edge 70. Sourced by image/build.

# The device's own packages, found in packages/ of the device's image cache.
packages=()

# Boot images in the vault's boot/, until the image builds its own.
boot_img=boot-230.img
init_boot_img=init_boot-8.img
# The stock init_boot, the template of image/init-boot's header and footer.
init_boot_template=stock/firmware-W1WR36.39-115/init_boot.img

# Our init_boot stops in rescue (SSH over USB, root not in use) when the root
# holds rescue_flag: image/install-userdata, for quick tries on a phone that
# already runs an image.
rescue_flag=/etc/moto70-mainline-rescue
ssh_host=roadstr
