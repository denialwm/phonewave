# The services every phone runs. When a package first installs one,
# phonewave-system's pacman hook turns it on, and the image gets them the
# same way; what the user turns off later stays off. A device turns on the
# services its hardware has from its boot image's tail.
enable denial.service
enable sshd.service
enable NetworkManager.service
enable systemd-networkd.service
enable systemd-resolved.service
enable bluetooth.service
enable upower.service
enable systemd-timesyncd.service
enable pacman-keyring.service
enable zram-swap.service
enable battery-statsd.service
enable hapticd.service
enable phonewave-droidloom.service
enable radio-addr-bluetooth.service
