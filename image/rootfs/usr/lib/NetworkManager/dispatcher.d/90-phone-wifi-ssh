#!/bin/sh
# Keep SSH restricted to USB and the last IPv4 address the Wi-Fi interface
# was given, whatever the kernel names it (wlan0, wlp1s0).
set -eu
[ -d "/sys/class/net/${1:-}/wireless" ] || exit 0
# Keep the existing listening sockets during a link-down transition. Reloading
# then can kill sshd when USB is unplugged and no configured address is local.
case "${2:-}" in up|dhcp4-change) ;; *) exit 0 ;; esac
exec 9>/run/phone-wifi-ssh.lock
flock 9
config=/etc/ssh/sshd_config.d/15-phone-wifi.conf
next=$(mktemp /etc/ssh/sshd_config.d/.phone-wifi.XXXXXX)
backup=$(mktemp /run/phone-wifi-ssh.XXXXXX)
trap 'rm -f "$next" "$backup"' EXIT HUP INT TERM
printf '# Managed by NetworkManager dispatcher 90-phone-wifi-ssh.\n' > "$next"
ip -4 -o address show dev "$1" scope global | awk '{ split($4,a,"/"); print "ListenAddress " a[1] }' >> "$next"
# An early/stale activation event must not remove the last listener either.
grep -q '^ListenAddress ' "$next" || exit 0

activate() {
    # A previous bind failure may have exhausted the automatic restart limit.
    systemctl reset-failed sshd.service
    systemctl reload-or-restart sshd.service
}

# Before the first Wi-Fi address there is no file yet.
[ -e "$config" ] || : > "$config"
# The image has no cmp: compare as text.
if [ "$(cat "$config")" = "$(cat "$next")" ]; then
    # A previous boot could have started sshd before this address existed.
    activate
    exit 0
fi
cp -p "$config" "$backup"
chmod 0644 "$next"
mv "$next" "$config"
if ! /usr/bin/sshd -t; then
    cp -p "$backup" "$config"
    exit 1
fi
if ! activate; then
    cp -p "$backup" "$config"
    activate || true
    exit 1
fi
logger -t phone-wifi-ssh "Updated SSH listener for the $1 address"
