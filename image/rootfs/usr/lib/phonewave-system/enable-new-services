#!/bin/sh
# pacman hook: the unit files a transaction installed come on stdin. Those
# 50-phonewave.preset names are enabled: system services also started on a
# running phone, user services for every user, from their next session.
# Upgrades leave units alone, so what the user turned off stays off.
set -eu
system=
user=
while read -r path; do
  unit=${path##*/}
  case $path in
    usr/lib/systemd/user/*) preset=/usr/lib/systemd/user-preset/50-phonewave.preset ;;
    *) preset=/usr/lib/systemd/system-preset/50-phonewave.preset ;;
  esac
  grep -qxF "enable $unit" "$preset" || continue
  case $path in
    usr/lib/systemd/user/*) user="$user $unit" ;;
    *) system="$system $unit" ;;
  esac
done
[ -z "$user" ] || systemctl --global enable $user
[ -n "$system" ] || exit 0
if [ -d /run/systemd/system ]; then
  exec systemctl enable --now $system
fi
exec systemctl enable $system
