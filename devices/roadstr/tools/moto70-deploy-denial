#!/usr/bin/env bash
# Stage a full moto70-build-denial candidate (native/, shell/, settings/) as a
# new set next to the running one, select it and restart denial-mainline.
# Files the running set already has are hard links to it. A new set never
# overwrites a mapped engine.
# No automatic rollback: the previous selection is printed for a manual switch.
# DENIAL_CANDIDATE is the candidate directory.
set -euo pipefail

B=${DENIAL_CANDIDATE:?set DENIAL_CANDIDATE to the candidate directory}
MOTO_HOST=${MOTO_HOST:-roadstr-wifi}
SETS=/var/lib/moto70-denial
UNIT=denial-mainline
SSH_OPTS=(-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=5)
moto() { ssh "${SSH_OPTS[@]}" "$MOTO_HOST" "$@"; }

stage() {
    local base deniald libapp head id st
    "$(dirname "$0")/moto70-build-denial" verify --candidate "$B"
    base=$(moto readlink -f "$SETS/mainline-current")
    [[ $base == "$SETS"/* ]] || { echo "unexpected base $base" >&2; exit 1; }
    deniald=$(sha256sum "$B/native/deniald" | cut -d' ' -f1)
    libapp=$(sha256sum "$B/shell/lib/libapp.so" | cut -d' ' -f1)
    head=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["head"])' "$B/source-manifest.json")
    id=denial-$(date +%Y%m%d-%H%M%S)-${deniald:0:8}-${libapp:0:8}
    st=$SETS/.staging-$id
    python3 - "$id" "$base" "$head" >"$B/deployment.json" <<'PY'
import json, sys
ident, base, head = sys.argv[1:]
print(json.dumps(dict(id=ident, base=base, source_head=head,
    changed='full moto70-build-denial candidate: native, shell, settings; unchanged files are hard links to base',
    mode='DEVELOPMENT, not release/runtime validated'), indent=2))
PY
    moto "rm -rf -- '$st'; mkdir -p -- '$st'"
    rsync -a --chown=root:root --compress --compress-choice=zstd -e "ssh ${SSH_OPTS[*]}" \
        --link-dest="$base" "$B/native" "$B/shell" "$B/settings" "$MOTO_HOST:$st/"
    rsync -a --chown=root:root -e "ssh ${SSH_OPTS[*]}" \
        "$B/SHA256SUMS" "$B/manifest.json" "$B/source-manifest.json" "$B/source.patch" \
        "$B/flutter.patch" "$B/skia.patch" "$B/build-recipe.py" "$B/deployment.json" "$MOTO_HOST:$st/"
    moto "set -e; cd '$st'; sha256sum --quiet -c SHA256SUMS
        chmod -R a-w . ; mv -T '$st' '$SETS/$id'"
    printf '%s\n' "$id" >"$B/staged-id"
    printf 'staged %s on base %s\n' "$id" "${base##*/}"
}

activate() {
    local id old
    id=$(<"$B/staged-id")
    old=$(moto systemctl show -p MainPID --value "$UNIT")
    moto "set -e; cd '$SETS'; echo previous=\$(readlink mainline-current)
        ln -sfn '$id' .mainline-current.new; mv -T .mainline-current.new mainline-current
        echo selected=\$(readlink mainline-current)
        systemctl restart '$UNIT'"
    printf 'restarted %s (old deniald %s)\n' "$UNIT" "$old"
}

verify() {
    moto "set -e; pid=\$(systemctl show -p MainPID --value '$UNIT')
        echo unit=\$(systemctl is-active '$UNIT') pid=\$pid
        echo selected=\$(readlink '$SETS/mainline-current')
        echo exe=\$(readlink /proc/\$pid/exe)
        sha256sum /proc/\$pid/exe
        awk '\$6 ~ /lib(app|flutter_engine)\\.so\$/ { print \$6 }' /proc/\$pid/maps | sort -u | xargs sha256sum
        journalctl -u '$UNIT' -b --since '-2min' --no-pager -o cat -p warning | tail -20"
}

case ${1:-} in
    stage) stage ;;
    activate) activate ;;
    verify) verify ;;
    *) echo "usage: $0 stage|activate|verify" >&2; exit 2 ;;
esac
