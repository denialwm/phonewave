// Settings sets the clock, its time zone, the language and the phone's name
// without a password: for the phone's owner, at the phone.
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.timedate1.set-time",
        "org.freedesktop.timedate1.set-timezone",
        "org.freedesktop.timedate1.set-ntp",
        "org.freedesktop.locale1.set-locale",
        // SetPrettyHostname asks for this one.
        "org.freedesktop.hostname1.set-static-hostname",
    ];
    if (allowed.indexOf(action.id) >= 0 && subject.local && subject.active &&
            subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
