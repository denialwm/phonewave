# Mesa 26.2.4 with the Adreno 722 for the Motorola Edge 70 (aarch64).
#
# Arch's mesa 1:26.2.4-1 with two patches (the A722 device entry, and no BV
# pipe for it in Turnip) and only the drivers this phone uses: freedreno (msm
# and kgsl) and Turnip, with llvmpipe, softpipe and zink as fallbacks. It
# replaces the same three packages the phone had installed. Build natively on
# the phone.
pkgbase=mesa
pkgname=(mesa vulkan-freedreno vulkan-mesa-implicit-layers)
pkgver=26.2.4
pkgrel=1.2
epoch=1
pkgdesc="Open-source OpenGL drivers (with the Adreno 722)"
url="https://www.mesa3d.org/"
arch=(aarch64)
license=("MIT AND BSD-3-Clause AND SGI-B-2.0")
makedepends=(
  bison clang expat flex glslang libclc libdisplay-info libdrm libelf libglvnd libx11
  libxcb libxext libxrandr libxshmfence libxxf86vm llvm llvm-libs lm_sensors
  meson python-mako python-packaging python-ply python-yaml
  spirv-llvm-translator spirv-tools wayland wayland-protocols xcb-util-keysyms
  zlib zstd
)
source=(
  "https://archive.mesa3d.org/mesa-$pkgver.tar.xz"
  0001-freedreno-add-Adreno-722.patch
  0002-turnip-no-BV-pipe-on-the-Adreno-722.patch
)
sha256sums=('bce5f7fbebb934373b86c999a064d52fb5065878dc57f287f95346648ec832e9'
            '80efb7d13d8a4400ed9b692b80264c4cf88ef3ee788d9797fd59ce3d6b663796'
            'b734a12830a633fa2196ff78a384c1a350e28434906eef325a0250a9b096fd7b')

prepare() {
  cd mesa-$pkgver
  patch -Np1 < ../0001-freedreno-add-Adreno-722.patch
  patch -Np1 < ../0002-turnip-no-BV-pipe-on-the-Adreno-722.patch
  # Same version string scheme as Arch, so caches keyed on it invalidate.
  echo "$pkgver-arch$epoch.$pkgrel" > VERSION
}

build() {
  local meson_options=(
    --optimization 2
    -D b_ndebug=true
    -D android-libbacktrace=disabled
    -D freedreno-kmds=msm,kgsl
    -D gallium-drivers=freedreno,zink,llvmpipe,softpipe
    -D gallium-extra-hud=true
    -D gallium-mediafoundation=disabled
    -D gallium-rusticl=false
    -D gallium-va=disabled
    -D gles1=disabled
    -D html-docs=disabled
    -D intel-rt=disabled
    -D libunwind=disabled
    -D microsoft-clc=disabled
    -D teflon=false
    -D valgrind=disabled
    -D video-codecs=
    -D vulkan-drivers=freedreno
    -D vulkan-layers=device-select,anti-lag
    -D vulkan-manifest-per-architecture=false
  )
  arch-meson mesa-$pkgver build "${meson_options[@]}"
  meson compile -C build
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv -v "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_mesa() {
  depends=(expat glibc libdrm libelf libgcc libglvnd libstdc++ libx11 libxcb
           libxext libxshmfence libxxf86vm llvm-libs lm_sensors spirv-tools
           wayland zlib zstd)
  provides=("mesa-libgl=$epoch:$pkgver-$pkgrel" opengl-driver)
  conflicts=('mesa-libgl<17.0.1-2')
  replaces=('mesa-libgl<17.0.1-2')

  meson install -C build --destdir "$pkgdir" --no-rebuild
  (
    cd "$pkgdir"
    _pick vkfdreno usr/lib/libvulkan_freedreno.so
    _pick vkfdreno usr/share/vulkan/icd.d/freedreno_icd.json
    _pick vklayers usr/lib/libVkLayer_MESA_device_select.so
    _pick vklayers usr/lib/libVkLayer_MESA_anti_lag.so
    _pick vklayers usr/share/vulkan/implicit_layer.d/VkLayer_MESA_device_select.json
    _pick vklayers usr/share/vulkan/implicit_layer.d/VkLayer_MESA_anti_lag.json
  )
  # glvnd provides libGL, libEGL, libGLES*, so Mesa's own GL headers stay.
  install -Dm644 mesa-$pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_vulkan-freedreno() {
  pkgdesc="Open-source Vulkan driver for Adreno GPUs (with the Adreno 722)"
  depends=(expat glibc libdisplay-info libdrm libgcc libstdc++ libx11 libxcb
           libxshmfence spirv-tools systemd-libs vulkan-icd-loader
           vulkan-mesa-implicit-layers wayland xcb-util-keysyms zlib zstd)
  provides=(vulkan-driver)
  mv vkfdreno/* "$pkgdir"
  install -Dm644 mesa-$pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_vulkan-mesa-implicit-layers() {
  pkgdesc="Mesa's implicit Vulkan layers"
  depends=(glibc libdrm libxcb wayland)
  conflicts=(vulkan-mesa-device-select)
  replaces=(vulkan-mesa-device-select)
  mv vklayers/* "$pkgdir"
  install -Dm644 mesa-$pkgver/docs/license.rst -t "$pkgdir/usr/share/licenses/$pkgname"
}
