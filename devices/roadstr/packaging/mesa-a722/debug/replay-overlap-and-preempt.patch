freedreno replay: overlap and preempt captured submits

FD_REPLAY_REPEAT=N queues each submit N times without waiting in between,
FD_REPLAY_GAP_US waits that long between them, and FD_REPLAY_PRIO puts the
queue on that priority with preemption allowed, as Turnip's queues are.
Run two replays on different priorities to make one preempt the other.

--- a/src/freedreno/decode/replay.c
+++ b/src/freedreno/decode/replay.c
@@ -479,9 +479,11 @@
       printf("Allocated iova %" PRIx64 "\n", dev->va_iova);
    }
 
+   const char *prio_env = getenv("FD_REPLAY_PRIO");
    struct drm_msm_submitqueue req_queue = {
-      .flags = 0,
-      .prio = 0,
+      /* As Turnip on A7xx with preemption */
+      .flags = prio_env ? MSM_SUBMITQUEUE_ALLOW_PREEMPT : 0,
+      .prio = prio_env ? atoi(prio_env) : 0,
    };
 
    ret = drmCommandWriteRead(dev->fd, DRM_MSM_SUBMITQUEUE_NEW, &req_queue,
@@ -587,11 +589,20 @@
       .syncobj_stride = sizeof(struct drm_msm_syncobj),
    };
 
-   int ret = drmCommandWriteRead(dev->fd, DRM_MSM_GEM_SUBMIT, &submit_req,
-                                 sizeof(submit_req));
-
-   if (ret) {
-      err(1, "DRM_MSM_GEM_SUBMIT failure %d", ret);
+   /* FD_REPLAY_REPEAT=N queues the same submit N times without waiting in
+    * between, so consecutive submits overlap on the GPU.
+    */
+   const char *repeat_env = getenv("FD_REPLAY_REPEAT");
+   int repeat = repeat_env ? atoi(repeat_env) : 1;
+   int ret = 0;
+   for (int r = 0; r < MAX2(repeat, 1); r++) {
+      ret = drmCommandWriteRead(dev->fd, DRM_MSM_GEM_SUBMIT, &submit_req,
+                                sizeof(submit_req));
+      if (ret) {
+         err(1, "DRM_MSM_GEM_SUBMIT failure %d", ret);
+      }
+      if (getenv("FD_REPLAY_GAP_US"))
+         usleep(atoi(getenv("FD_REPLAY_GAP_US")));
    }
 
    /* Wait for submission to complete in order to be sure that
@@ -602,7 +613,7 @@
       .fence = submit_req.fence,
       .queueid = dev->queue_id,
    };
-   get_abs_timeout(&wait_req.timeout, 1000000000);
+   get_abs_timeout(&wait_req.timeout, 10000000000ull);
 
    ret =
       drmCommandWrite(dev->fd, DRM_MSM_WAIT_FENCE, &wait_req, sizeof(wait_req));
