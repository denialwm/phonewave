#!/usr/bin/env python3
"""Print 32-bit registers: tb373fu-mmio-dump ADDRESS LENGTH [ADDRESS LENGTH...]

Maps /dev/mem writable, as ctypes needs, but only reads it, one aligned
32-bit word at a time: wider or byte reads can fault on device registers.
"""
import ctypes
import mmap
import os
import sys

PAGE = mmap.PAGESIZE
args = [int(a, 0) for a in sys.argv[1:]]
if not args or len(args) % 2:
    sys.exit(__doc__)
fd = os.open('/dev/mem', os.O_RDWR | os.O_SYNC)
for address, length in zip(args[::2], args[1::2]):
    base = address & ~(PAGE - 1)
    size = (address + length - base + PAGE - 1) & ~(PAGE - 1)
    with mmap.mmap(fd, size, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=base) as mem:
        for line in range(address, address + length, 16):
            words = []
            for at in range(line, min(line + 16, address + length), 4):
                words.append('%08x' % ctypes.c_uint32.from_buffer(mem, at - base).value)
            print('%08x: %s' % (line, ' '.join(words)))
os.close(fd)
