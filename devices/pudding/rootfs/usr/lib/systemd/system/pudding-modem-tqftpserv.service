[Unit]
Description=Xiaomi 17 modem file server (tqftpserv)

[Service]
Type=exec
ExecStart=/usr/local/bin/tqftpserv
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/tqftpserv
