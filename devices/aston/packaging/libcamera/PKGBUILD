# libcamera 0.7.2 for the OnePlus Ace 3 (aarch64).
#
# Arch's libcamera 0.7.2-4 with seven patches: sensor helpers, properties and
# simple-IPA tuning for the Sony IMX355 (ultrawide) and IMX890 (main), both
# with the stock colour matrices, and the Samsung S5K3P9 (front); a simple-IPA
# exposure loop that meters 18% grey and holds highlights; and white balance
# estimated from grey zones on the stock illuminant locus of the IMX890. Only the
# three packages the phone has installed are built, without documentation,
# qcam, GStreamer or Python. Build natively on the phone.
pkgbase=libcamera
pkgname=(libcamera libcamera-ipa libcamera-tools)
pkgver=0.7.2
pkgrel=4.7
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS (with the Ace 3 sensors)"
arch=(aarch64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
makedepends=(
  git
  gnutls
  libdrm
  libelf
  libevent
  libglvnd
  libjpeg-turbo
  libtiff
  libunwind
  libyaml
  libyuv
  meson
  python-jinja
  python-ply
  python-pyyaml
  sdl2
  systemd
)
source=(
  "git+$_url#tag=v$pkgver"
  "$pkgbase-fix-python3.14-macro-redefinition.patch"
  0001-ipa-simple-add-sony-imx355.patch
  0002-ipa-simple-add-s5k3p9-and-imx355-colour.patch
  0003-ipa-simple-add-sony-imx890.patch
  0004-ipa-simple-meter-exposure-on-mean-and-highlights.patch
  0005-ipa-simple-add-sony-imx890-colour.patch
  0006-ipa-simple-constrain-white-balance-to-a-locus.patch
  0007-ipa-simple-estimate-white-balance-from-grey-zones.patch
)
sha256sums=('SKIP'
            '2eb9407d11ea073e3c392bbb584b75803ce1b2a3d73afaefda5c1fa799c151ad'
            '17d43833551f23dfca1c3ac0cbd17a4e7d06b8ac2efc51a9707fc160e967819b'
            'e791093110b7745f4b34386c6b571400a28a387d63c6858ab3fae36ddb1adcfe'
            '6ad73639a738770f0fbb79f5e7d56c09b45a221bbd776aa2992116e017360f9c'
            'b5d1f27c8b91518d9d7556a7c633216134f2d9cf9b26ee3235ff7d97192e4ccd'
            '8f7c7e96d7a9ab3d1e57bc6d84d9a4692d4bed4f5325f389daf2be3883aacf60'
            '39302b3ba9d572fb49651ea9799c1316a039535884ecec7bb8d5c3189a085e63'
            'ff1bbe35f4395bea7a8ed0833119d74c1212ec4b9cf0ccecfc82534b082f7f75')

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd $pkgbase
  patch -Np1 < ../$pkgbase-fix-python3.14-macro-redefinition.patch
  patch -Np1 < ../0001-ipa-simple-add-sony-imx355.patch
  patch -Np1 < ../0002-ipa-simple-add-s5k3p9-and-imx355-colour.patch
  patch -Np1 < ../0003-ipa-simple-add-sony-imx890.patch
  patch -Np1 < ../0004-ipa-simple-meter-exposure-on-mean-and-highlights.patch
  patch -Np1 < ../0005-ipa-simple-add-sony-imx890-colour.patch
  patch -Np1 < ../0006-ipa-simple-constrain-white-balance-to-a-locus.patch
  patch -Np1 < ../0007-ipa-simple-estimate-white-balance-from-grey-zones.patch

  # add version, so that utils/gen-version.sh may rely on it
  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  local meson_options=(
    -D v4l2=enabled
    -D tracing=disabled
    -D test=false
    -D documentation=disabled
    -D gstreamer=disabled
    -D pycamera=disabled
    -D qcam=disabled
    -D lc-compliance=disabled
    -D rpi-awb-nn=disabled
    # GCC 16 reports a false -Warray-bounds in std::shared_ptr<std::mutex>.
    -D werror=false
  )

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

package_libcamera() {
  license=(
    Apache-2.0
    CC0-1.0
    'GPL-2.0-only WITH Linux-syscall-note'
    GPL-2.0-or-later
    LGPL-2.1-or-later
    'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
    'GPL-2.0-or-later WITH Linux-syscall-note OR MIT'
  )
  depends=(
    glibc
    gnutls
    libcamera-ipa
    libelf
    libgcc
    libglvnd
    libstdc++
    libunwind
    libyaml
    libyuv
    sh
    systemd-libs libudev.so
  )
  optdepends=('libcamera-tools: for applications')
  provides=(libcamera.so libcamera-base.so)

  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/{BSD-3-Clause,Linux-syscall-note,MIT}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"

  (
    cd "$pkgdir"
    _pick $pkgbase-ipa usr/lib/libcamera/
    _pick $pkgbase-tools usr/bin/{cam,libcamera-bug-report}
  )
}

package_libcamera-ipa() {
  pkgdesc+=" - signed IPA"
  license=(
    BSD-2-Clause
    CC-BY-SA-4.0
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libgcc
    libstdc++
  )
  # stripping requires re-signing of IPA libs, so we do it manually
  options=(!strip)

  strip $pkgname/usr/lib/libcamera/*{.so,proxy}
  for _lib in $pkgname/usr/lib/libcamera/*.so; do
    $pkgbase/src/ipa/ipa-sign.sh "$(find build -type f -iname "*ipa-priv-key.pem")" "$_lib" "$_lib.sign"
  done
  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_libcamera-tools() {
  pkgdesc+=" - tools"
  license=(
    BSD-2-Clause
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libdrm
    libevent libevent-2.1.so libevent_pthreads-2.1.so
    libgcc
    libjpeg-turbo libjpeg.so
    libstdc++
    libtiff libtiff.so
    libyaml
    sdl2
  )

  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
