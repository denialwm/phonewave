From 75e1386f5abdd3c89b59d3c406606032a4a26378 Mon Sep 17 00:00:00 2001
From: Doctor Logix <doctor.logix@gmail.com>
Date: Wed, 21 Oct 2026 22:10:28 +0200
Subject: [PATCH] ipa: simple: Add Sony IMX890 colour tuning

Give the IMX890 tuning file the colour correction matrices of the OnePlus
Ace 3 stock tuning for its QTech module: the bright, non-flash branch,
keyed to the start of each CCT trigger. The stock matrix for the
[1, 2] K trigger and the duplicate 7600 K entry are left out.
---
 src/ipa/simple/data/imx890.yaml | 44 +++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/src/ipa/simple/data/imx890.yaml b/src/ipa/simple/data/imx890.yaml
index e903d96..e0f7a07 100644
--- a/src/ipa/simple/data/imx890.yaml
+++ b/src/ipa/simple/data/imx890.yaml
@@ -6,6 +6,50 @@ algorithms:
   - BlackLevel:
       blackLevel: 4096
   - Awb:
+  # Colour correction from the OnePlus Ace 3 stock tuning (QTech module):
+  # the bright, non-flash branch, keyed to the start of each CCT trigger.
+  - Ccm:
+      ccms:
+        - ct: 2500
+          ccm: [  1.46, -0.47,  0.01,
+                 -0.35,  1.28,  0.07,
+                 -0.14, -0.63,  1.77 ]
+        - ct: 2700
+          ccm: [  1.51, -0.58,  0.07,
+                 -0.35,  1.31,  0.04,
+                 -0.02, -0.76,  1.78 ]
+        - ct: 3400
+          ccm: [  1.51, -0.58,  0.07,
+                 -0.30,  1.26,  0.04,
+                 -0.02, -0.76,  1.78 ]
+        - ct: 3800
+          ccm: [  1.55, -0.50, -0.05,
+                 -0.16,  1.30, -0.14,
+                  0.02, -0.60,  1.58 ]
+        - ct: 4400
+          ccm: [  1.55, -0.50, -0.05,
+                 -0.18,  1.30, -0.12,
+                 -0.01, -0.55,  1.56 ]
+        - ct: 4800
+          ccm: [  1.55, -0.52, -0.03,
+                 -0.15,  1.34, -0.19,
+                  0.01, -0.50,  1.49 ]
+        - ct: 5400
+          ccm: [  1.55, -0.51, -0.04,
+                 -0.14,  1.35, -0.21,
+                  0.02, -0.53,  1.51 ]
+        - ct: 6400
+          ccm: [  1.58, -0.56, -0.02,
+                 -0.14,  1.30, -0.16,
+                  0.02, -0.64,  1.62 ]
+        - ct: 6600
+          ccm: [  1.77, -0.80,  0.03,
+                 -0.17,  1.28, -0.11,
+                 -0.03, -0.64,  1.67 ]
+        - ct: 7400
+          ccm: [  1.77, -0.80,  0.03,
+                 -0.18,  1.28, -0.10,
+                 -0.05, -0.66,  1.71 ]
   - Adjust:
   - Agc:
 ...
-- 
