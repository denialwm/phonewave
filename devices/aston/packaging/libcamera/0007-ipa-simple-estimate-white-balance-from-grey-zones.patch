+/*
+ * Samples with a channel at or above this level, at 8 bits, are left out of the
+ * zone sums: a clipped channel would skew the zone's colour.
+ */
+static constexpr unsigned int kAwbSaturation = 250;
+
+#define SWSTATS_START_LINE_STATS(pixel_t, xEnd)                          \
+	pixel_t r, g, g2, b;                                              \
+	uint64_t yVal;                                                    \
+                                                                          \
+	uint64_t sumR = 0;                                                \
+	uint64_t sumG = 0;                                                \
+	uint64_t sumB = 0;                                                \
+                                                                          \
+	const unsigned int zoneEnd = (xEnd);                              \
+	const unsigned int zoneSat = kAwbSaturation << sumShift_;         \
+	const unsigned int zoneRow = y * SwIspStats::kAwbZonesY /         \
+				     window_.height * SwIspStats::kAwbZonesX;
+
+#define SWSTATS_ACCUMULATE_LINE_STATS(div)                                \
+	sumR += r;                                                        \
+	sumG += g;                                                        \
+	sumB += b;                                                        \
+                                                                          \
+	yVal = r * kRedYMul;                                              \
+	yVal += g * kGreenYMul;                                           \
+	yVal += b * kBlueYMul;                                            \
+	stats.yHistogram[yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div))]++; \
+                                                                          \
+	if (r < zoneSat && g < zoneSat && b < zoneSat) {                  \
+		unsigned int zone = zoneRow +                             \
+			x * SwIspStats::kAwbZonesX / zoneEnd;             \
+		stats.awbZoneSum[zone] += RGB<uint64_t>({ r, g, b });     \
+		stats.awbZoneCount[zone]++;                               \
+	}
 
 #define SWSTATS_FINISH_LINE_STATS() \
 	stats.sum_.r() += sumR;     \
 	stats.sum_.g() += sumG;     \
 	stats.sum_.b() += sumB;
 
