diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index 911fd71..21664a4 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -8,6 +8,7 @@
 #include "awb.h"
 
 #include <algorithm>
+#include <cmath>
 #include <errno.h>
 #include <limits>
 #include <numeric>
@@ -29,11 +30,17 @@ namespace ipa::soft::algorithms {
 /*
  * The optional locus lists the camera R/G and B/G ratios of a grey surface
  * under reference illuminants, ordered by colour temperature. When it is
- * present, the grey-world estimate is moved to the nearest point on the
- * locus. The part of the scene average that no illuminant explains, such as
- * a room's coloured light or a frame full of foliage, is then kept instead
- * of being neutralised, and the colour temperature follows the locus.
+ * present, the illuminant is estimated only from the statistics zones whose
+ * colour lies within kGreyZoneBand of the locus, so that coloured surfaces,
+ * such as a frame full of foliage, do not pull the estimate. The estimate is
+ * then moved onto the locus, which also gives the colour temperature. With
+ * no zone close enough, the whole-frame average is used instead.
  */
+static constexpr double kGreyZoneBand = 0.06;
+
+/* Zones darker than this, at 8 bits after black level, are too noisy. */
+static constexpr double kGreyZoneMinLevel = 4.0;
+
 int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 {
 	for (const auto &p : tuningData["locus"].asList()) {
@@ -53,17 +60,18 @@ int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
 	return 0;
 }
 
-void Awb::projectOnLocus(double &rg, double &bg, double &mired) const
+double Awb::projectOnLocus(double &rg, double &bg, double &mired) const
 {
 	double best = std::numeric_limits<double>::max();
 	const double qr = rg;
 	const double qb = bg;
 
 	if (locus_.size() == 1) {
+		best = std::hypot(qr - locus_[0].rg, qb - locus_[0].bg);
 		rg = locus_[0].rg;
 		bg = locus_[0].bg;
 		mired = locus_[0].mired;
-		return;
+		return best;
 	}
 
 	for (size_t i = 0; i + 1 < locus_.size(); i++) {
@@ -84,6 +92,8 @@ void Awb::projectOnLocus(double &rg, double &bg, double &mired) const
 			mired = a.mired + t * (b.mired - a.mired);
 		}
 	}
+
+	return std::sqrt(best);
 }
 
 int Awb::configure(IPAContext &context,
@@ -139,9 +149,39 @@ void Awb::process(IPAContext &context,
 	auto &gains = context.activeState.awb.gains;
 
 	if (!locus_.empty()) {
-		double rg = static_cast<double>(sum.r()) / sum.g();
-		double bg = static_cast<double>(sum.b()) / sum.g();
-		double mired;
+		RGB<double> grey{ { 0.0, 0.0, 0.0 } };
+		unsigned int zones = 0;
+		double rg, bg, mired;
+
+		for (unsigned int i = 0; i < SwIspStats::kAwbZones; i++) {
+			const uint32_t count = stats->awbZoneCount[i];
+			if (!count)
+				continue;
+
+			RGB<double> zone{ { static_cast<double>(stats->awbZoneSum[i].r()),
+					    static_cast<double>(stats->awbZoneSum[i].g()),
+					    static_cast<double>(stats->awbZoneSum[i].b()) } };
+			zone -= static_cast<double>(blackLevel) * count;
+			if (zone.g() < kGreyZoneMinLevel * count ||
+			    zone.r() <= 0 || zone.b() <= 0)
+				continue;
+
+			rg = zone.r() / zone.g();
+			bg = zone.b() / zone.g();
+			if (projectOnLocus(rg, bg, mired) > kGreyZoneBand)
+				continue;
+
+			grey += zone;
+			zones++;
+		}
+
+		if (zones) {
+			rg = grey.r() / grey.g();
+			bg = grey.b() / grey.g();
+		} else {
+			rg = static_cast<double>(sum.r()) / sum.g();
+			bg = static_cast<double>(sum.b()) / sum.g();
+		}
 
 		projectOnLocus(rg, bg, mired);
 
@@ -153,9 +193,7 @@ void Awb::process(IPAContext &context,
 			     context.activeState.awb.temperatureK);
 
 		LOG(IPASoftAwb, Debug)
-			<< "grey world R/G " << static_cast<double>(sum.r()) / sum.g()
-			<< " B/G " << static_cast<double>(sum.b()) / sum.g()
-			<< "; locus gain R/B: " << gains << "; temperature: "
+			<< zones << " grey zones; locus gain R/B: " << gains << "; temperature: "
 			<< context.activeState.awb.temperatureK;
 		return;
 	}
