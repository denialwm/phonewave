--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -43,6 +43,27 @@ struct SwIspStats {
 	 * \brief A histogram of luminance values of all the sampled pixels
 	 */
 	Histogram yHistogram;
+	/**
+	 * \brief Number of colour statistics zones across the window
+	 */
+	static constexpr unsigned int kAwbZonesX = 16;
+	/**
+	 * \brief Number of colour statistics zones down the window
+	 */
+	static constexpr unsigned int kAwbZonesY = 12;
+	/**
+	 * \brief Number of colour statistics zones
+	 */
+	static constexpr unsigned int kAwbZones = kAwbZonesX * kAwbZonesY;
+	/**
+	 * \brief Sums of colour channels per zone, in raster order, of the
+	 * sampled pixels that have no saturated channel
+	 */
+	std::array<RGB<uint64_t>, kAwbZones> awbZoneSum;
+	/**
+	 * \brief Number of pixels summed in each zone of awbZoneSum
+	 */
+	std::array<uint32_t, kAwbZones> awbZoneCount;
 };
 
 } /* namespace libcamera */
