#!/usr/bin/env python3
"""Apply the tablet's measured SHM policy; save original values for restore."""
import argparse
import json
import os
from pathlib import Path

ROOT = Path('/sys/kernel/mm/transparent_hugepage')
RECORD = Path('/run/pad4-vm-tuning/state.json')
DESIRED = {'shmem_enabled': 'within_size', 'defrag': 'never'}


def selected(name):
    return next(word[1:-1] for word in (ROOT / name).read_text().split() if word.startswith('['))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('apply', 'restore', 'status'))
    args = parser.parse_args()
    assert os.geteuid() == 0
    assert Path('/etc/pad4-root-id').read_text().strip() == '59b8e7b3:archroot-v1'
    boot_id = Path('/proc/sys/kernel/random/boot_id').read_text().strip()
    current = lambda: {name: selected(name) for name in DESIRED}
    if args.action == 'apply':
        if RECORD.exists():
            record = json.loads(RECORD.read_text())
            assert record['boot_id'] == boot_id and record['desired'] == DESIRED
        else:
            record = {'boot_id': boot_id, 'kernel': os.uname().release,
                      'original': current(), 'desired': DESIRED}
            RECORD.parent.mkdir(mode=0o700, exist_ok=True)
            RECORD.write_text(json.dumps(record, indent=2) + '\n')
        # Avoid allocation compaction before enabling additional huge pages.
        for name in ('defrag', 'shmem_enabled'):
            (ROOT / name).write_text(DESIRED[name] + '\n')
            assert selected(name) == DESIRED[name]
    elif args.action == 'restore' and RECORD.exists():
        record = json.loads(RECORD.read_text())
        assert record['boot_id'] == boot_id
        # An external policy change belongs to its author; don't overwrite it.
        assert current() == record['desired'], 'Policy changed externally; original values retained in state.json'
        for name in ('shmem_enabled', 'defrag'):
            (ROOT / name).write_text(record['original'][name] + '\n')
            assert selected(name) == record['original'][name]
        RECORD.unlink()
    print(json.dumps({'kernel': os.uname().release, 'values': current(),
                      'saved_original': json.loads(RECORD.read_text()) if RECORD.exists() else None}, indent=2))


if __name__ == '__main__':
    main()
